{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/explainable-ml",
        "destination": "/explainable-ml.html"
      },
      {
        "source": "/gods-eye-view",
        "destination": "/gods-eye-view.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
