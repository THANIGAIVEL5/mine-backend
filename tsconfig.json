{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "./public/js",
    "rootDir": "./src/ts",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "ES2022"]
  },
  "include": ["src/ts/**/*"]
}
