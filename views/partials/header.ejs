<!-- Top Tactical HUD Header Component -->
<header class="fixed top-0 left-64 right-0 h-20 bg-[#080808]/95 backdrop-blur-xl border-b border-white/10 z-40 flex flex-col justify-center px-6 py-2 gap-1.5 shadow-md">
  <div class="flex items-center justify-between w-full">
    <div class="flex items-center gap-2 px-3 py-1 rounded bg-white/10 border border-white/20">
      <div class="relative flex items-center justify-center w-2.5 h-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-white animate-ping absolute"></span>
        <span class="w-2 rounded-full bg-white h-2"></span>
      </div>
      <span class="font-['JetBrains_Mono'] text-[11px] text-white uppercase tracking-wider font-bold">ELEVATED SUBSIDENCE WATCH - SECTOR 4B</span>
    </div>
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2 font-['JetBrains_Mono'] text-[11px] bg-neutral-900/90 px-2.5 py-1 rounded border border-emerald-500/30">
        <span class="text-zinc-400 uppercase">NODES:</span>
        <span id="header-nodes-online" class="text-emerald-400 font-bold">5 ONLINE</span>
        <span class="text-zinc-600">/</span>
        <span class="text-emerald-300 text-[10px] font-bold">0 OFF</span>
        <span class="text-zinc-600">/</span>
        <span class="text-emerald-400 text-[10px]">100% HEALTH</span>
      </div>
      <div id="uplink-container" class="flex items-center gap-2 font-['JetBrains_Mono'] text-[11px] bg-neutral-900/90 px-2.5 py-1 rounded border border-emerald-500/30">
        <span class="text-zinc-400 uppercase">UPLINK:</span>
        <span id="uplink-status-badge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center gap-1.5 shadow-[0_0_10px_rgba(16,185,129,0.25)]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>● CONNECTED (WEBSOCKET / STREAM ACTIVE)
        </span>
      </div>
      <button onclick="toggleHardwareStream()" id="btn-hardware-toggle" title="Toggle Live Physical Hardware Stream Simulation" class="px-2.5 py-1 rounded bg-neutral-900 hover:bg-neutral-800 border border-white/20 text-zinc-300 hover:text-white font-['JetBrains_Mono'] text-[10px] uppercase font-bold flex items-center gap-1 transition cursor-pointer active:scale-95">
        <span class="material-symbols-outlined text-[13px] text-emerald-400">sensors</span> <span id="hardware-toggle-text">HARDWARE LINK: ACTIVE</span>
      </button>
      <div class="flex items-center gap-1.5 font-['JetBrains_Mono'] text-[11px] text-white">
        <span class="material-symbols-outlined text-zinc-300 text-[16px]">schedule</span>
        <span id="live-clock">IST UTC+5:30 REAL-TIME</span>
      </div>
      <div class="w-7 h-7 rounded bg-white/10 border border-white/20 flex items-center justify-center">
        <span class="material-symbols-outlined text-white text-[16px]">person</span>
      </div>
    </div>
  </div>
  <div class="flex items-center justify-between w-full pt-1 border-t border-white/5">
    <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-[10px]">
      <span class="text-white uppercase tracking-widest font-semibold flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>{{ systemMode | default('SYSTEM MODE: REALTIME CONTINUOUS INGESTION') }}
      </span>
      <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
      <span class="text-zinc-400 uppercase">{{ targetGeometry | default('TARGET GEOMETRY: DRIFT & SHAFT 12') }}</span>
    </div>
    <div class="font-['JetBrains_Mono'] text-[10px] text-zinc-400 flex items-center gap-2">
      <span class="text-white font-bold flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>CHASNALA SHAFT 4B ACTIVE STREAM
      </span>
    </div>
  </div>
</header>
