<!-- Floating Cyber HUD AI Chat Assistant Widget -->
<div class="fixed bottom-5 right-5 z-50 font-mono">
  <!-- Chat Toggle Button -->
  <button id="chat-toggle-btn" onclick="openChatWindow()" class="relative flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-[#0a0a0a] border border-white/20 text-white hover:bg-white/10 hover:border-white transition-all shadow-[0_0_15px_rgba(255,255,255,0.1)] backdrop-blur-md cursor-pointer">
    <span class="relative flex h-3 w-3">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
    </span>
    <span class="material-symbols-outlined text-lg">smart_toy</span>
    <span class="text-xs font-bold tracking-wider uppercase">Master AI Controller</span>
    <span id="chat-badge" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-white rounded-full border-2 border-[#0a0a0a]"></span>
  </button>

  <!-- Chat Modal Window -->
  <div id="chat-window" class="hidden absolute bottom-14 right-0 w-80 sm:w-[430px] h-[540px] rounded-xl bg-[#0a0a0a]/98 border border-white/20 shadow-[0_0_35px_rgba(0,0,0,0.95)] backdrop-blur-xl flex flex-col overflow-hidden transition-all duration-300">
    <!-- Chat Header -->
    <div class="flex items-center justify-between px-3.5 py-2.5 bg-[#141414] border-b border-white/10">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-white text-base">psychology</span>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="text-xs font-bold text-white tracking-wide">TERRA-SENTINEL OMNI-AI</h4>
            <span class="px-1.5 py-0.5 rounded text-[8px] font-bold bg-white/10 text-white border border-white/20">FULL TELEMETRY GOVERNANCE ACTIVE</span>
          </div>
          <div class="flex items-center gap-1.5 text-[9px] text-zinc-400">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
            <span>[5 SENSOR NODES • 12 TELEMETRY CHANNELS • AUTONOMOUS INTERLOCK]</span>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button onclick="toggleChatMaximize()" title="Maximize / Restore Terminal" class="text-zinc-400 hover:text-white p-1 rounded transition cursor-pointer">
          <span id="chat-max-icon" class="material-symbols-outlined text-sm">open_in_full</span>
        </button>
        <button onclick="toggleApiKeyModal()" title="Cloud Intelligence Uplink Settings" class="text-zinc-400 hover:text-white p-1 rounded transition cursor-pointer">
          <span class="material-symbols-outlined text-sm">settings</span>
        </button>
        <button id="chat-close-btn" onclick="closeChatWindow()" class="text-zinc-400 hover:text-white p-1 rounded transition cursor-pointer">
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      </div>
    </div>

    <!-- Telemetry Governance Ribbon -->
    <div class="flex items-center justify-between px-3 py-1.5 bg-[#0f0f0f] border-b border-white/10 text-[10px] text-zinc-400">
      <span class="flex items-center gap-1">
        <span class="material-symbols-outlined text-xs text-white">tune</span> 5 Nodes • 12 Channels Synced
      </span>
      <span class="text-white font-mono text-[9px]">AUTONOMOUS INTERLOCK READY</span>
    </div>

    <!-- Operator Interference & Command Overrides Section -->
    <div class="px-3 py-1.5 bg-[#121212] border-b border-white/10 flex flex-col gap-1">
      <div class="flex items-center justify-between text-[9px] font-bold font-mono">
        <span class="text-white flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
          <span>⚡ OPERATOR INTERFERENCE (1-CLICK OVERRIDES)</span>
        </span>
        <span class="text-zinc-400 text-[8px] uppercase tracking-wider">Direct Physical Interlocks</span>
      </div>
      <div class="flex gap-1.5 overflow-x-auto scrollbar-none py-0.5 whitespace-nowrap">
        <button onclick="sendQuickChat('INTERVENE: Trigger Klaxon Evacuation')" class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 border border-white/30 text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer">
          <span class="material-symbols-outlined text-xs text-white">warning</span> 🚨 Evacuate Klaxon
        </button>
        <button onclick="sendQuickChat('INTERVENE: 100% Ventilation Boost')" class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 border border-white/30 text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer">
          <span class="material-symbols-outlined text-xs text-white">mode_fan</span> 💨 100% Vent Boost
        </button>
        <button onclick="sendQuickChat('INTERVENE: Force 500 GPM Dewatering Pump')" class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 border border-white/30 text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer">
          <span class="material-symbols-outlined text-xs text-white">water_drop</span> 💧 Force Dewatering
        </button>
        <button onclick="sendQuickChat('INTERVENE: Pre-tension Chocks to 350 Bar')" class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 border border-white/30 text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer">
          <span class="material-symbols-outlined text-xs text-white">compress</span> 🛡️ Pre-tension Chocks
        </button>
        <button onclick="sendQuickChat('INTERVENE: Reset Baseline to STABLE')" class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 border border-white/30 text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer">
          <span class="material-symbols-outlined text-xs text-white">restart_alt</span> 🔄 Reset STABLE
        </button>
      </div>
    </div>

    <!-- Tactical Telemetry Inquiries Strip -->
    <div class="flex gap-1.5 px-3 py-1.5 overflow-x-auto bg-[#0d0d0d] border-b border-white/10 text-[10px] scrollbar-none whitespace-nowrap">
      <span class="text-zinc-500 font-mono text-[9px] self-center mr-1">QUERY:</span>
      <button onclick="sendQuickChat('What is current mine status?')" class="px-2 py-0.5 rounded bg-neutral-900 hover:bg-white/15 hover:text-white text-zinc-300 border border-white/10 transition cursor-pointer">📊 Mine Status</button>
      <button onclick="sendQuickChat('Check gas and CO levels')" class="px-2 py-0.5 rounded bg-neutral-900 hover:bg-white/15 hover:text-white text-zinc-300 border border-white/10 transition cursor-pointer">💨 Gas &amp; CO</button>
      <button onclick="sendQuickChat('Explain current subsidence risk')" class="px-2 py-0.5 rounded bg-neutral-900 hover:bg-white/15 hover:text-white text-zinc-300 border border-white/10 transition cursor-pointer">🏔️ Subsidence</button>
      <button onclick="sendQuickChat('What are DGMS statutory limits for CO and roof flexure?')" class="px-2 py-0.5 rounded bg-neutral-900 hover:bg-white/15 hover:text-white text-zinc-300 border border-white/10 transition cursor-pointer">📋 DGMS Rules</button>
    </div>

    <!-- Chat Messages Scrollable Feed -->
    <div id="chat-messages" class="flex-1 p-3.5 overflow-y-auto space-y-2 bg-[#080808]">
      <div class="flex flex-col items-start mb-3">
        <div class="flex items-center gap-1.5 text-[10px] uppercase font-mono text-white mb-1">
          <span>TERRA-SENTINEL MASTER AI</span>
          <span class="px-1 py-0.2 rounded text-[8px] bg-white/10 border border-white/20 text-white">Central Controller</span>
          <span class="text-zinc-500">• LIVE</span>
        </div>
        <div class="max-w-[85%] rounded-lg px-3.5 py-2 text-xs font-sans leading-relaxed bg-[#141414] border border-white/20 text-zinc-100 shadow-lg">
          Welcome Operator. I am the central <strong>TERRA-SENTINEL Master AI Controller</strong> with autonomous oversight of all 5 underground sensor nodes, hydraulic powered roof chocks, drainage sumps, and DGMS emergency safety interlocks.
        </div>
      </div>
    </div>

    <!-- Chat Input Area -->
    <div class="p-2.5 bg-[#141414] border-t border-white/10 flex items-center gap-2">
      <input id="chat-input" type="text" onkeydown="if(event.key==='Enter') sendUserChatMessage();" placeholder="Command Master AI or enter intervention directive (e.g. Evacuate, Drain Sump)..." class="flex-1 bg-[#050505] border border-white/20 focus:border-white focus:outline-none text-xs text-white px-3 py-2 rounded-lg font-sans placeholder-zinc-500" />
      <button id="chat-send-btn" onclick="sendUserChatMessage()" class="bg-white hover:bg-zinc-200 text-black p-2 rounded-lg font-bold transition flex items-center justify-center cursor-pointer active:scale-95">
        <span class="material-symbols-outlined text-sm">send</span>
      </button>
    </div>
  </div>

  <!-- Gemini API Key Configuration Modal -->
  <div id="gemini-key-modal" class="hidden absolute bottom-16 right-0 w-80 sm:w-96 p-4 rounded-xl bg-[#0a0a0a] border border-white/20 shadow-[0_0_35px_rgba(0,0,0,0.95)] backdrop-blur-xl z-50">
    <div class="flex items-center justify-between pb-2 mb-3 border-b border-white/10">
      <div class="flex items-center gap-2 text-xs font-bold text-white">
        <span class="material-symbols-outlined text-white text-base">key</span>
        <span>CLOUD REASONING UPLINK</span>
      </div>
      <button onclick="toggleApiKeyModal()" class="text-zinc-400 hover:text-white cursor-pointer">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>
    </div>
    <p class="text-[11px] text-zinc-400 leading-relaxed mb-3">
      Optionally link a Google Gemini API Key to amplify the Master AI with frontier multi-billion parameter reasoning:
    </p>
    <input id="gemini-key-input" type="password" placeholder="AIzaSy..." class="w-full bg-[#141414] border border-white/20 text-xs text-white px-3 py-2 rounded mb-3 focus:outline-none focus:border-white font-mono" />
    <div class="flex items-center justify-end gap-2 text-xs font-mono">
      <button onclick="toggleApiKeyModal()" class="px-3 py-1.5 text-zinc-400 hover:text-white transition cursor-pointer">Cancel</button>
      <button onclick="saveGeminiKey()" class="px-3 py-1.5 bg-white text-black font-bold rounded hover:bg-zinc-200 transition cursor-pointer">Save &amp; Activate</button>
    </div>
  </div>
</div>
