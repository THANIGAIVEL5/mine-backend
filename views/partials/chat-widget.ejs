<!-- Floating Cyber HUD AI Chat Assistant Widget (AngularJS Component) -->
<div ng-controller="ChatWidgetController as chat" class="fixed bottom-5 right-5 z-50 font-mono" ng-cloak>
  <!-- Chat Toggle Button -->
  <button id="chat-toggle-btn" ng-click="chat.openWindow()" class="relative flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white dark:bg-[#0a0a0a] border border-slate-700 dark:border-white/20 hover:border-slate-500 dark:hover:border-white transition-all shadow-lg backdrop-blur-md cursor-pointer">
    <span class="relative flex h-3 w-3">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 dark:bg-white opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-sky-400 dark:bg-white"></span>
    </span>
    <span class="material-symbols-outlined text-lg">smart_toy</span>
    <span class="text-xs font-bold tracking-wider uppercase">Master AI Controller</span>
    <span id="chat-badge" ng-show="chat.hasUnread" class="absolute -top-1 -right-1 w-3 h-3 bg-rose-500 rounded-full border-2 border-white dark:border-[#0a0a0a] animate-pulse"></span>
  </button>

  <!-- Chat Modal Window -->
  <div id="chat-window" ng-show="chat.isOpen" ng-class="{'w-full max-w-[540px] h-[640px]': chat.isMaximized, 'w-80 sm:w-[430px] h-[540px]': !chat.isMaximized}" class="absolute bottom-14 right-0 rounded-xl bg-white/98 dark:bg-[#0a0a0a]/98 border border-slate-200 dark:border-white/20 shadow-2xl backdrop-blur-xl flex flex-col overflow-hidden transition-all duration-300">
    <!-- Chat Header -->
    <div class="flex items-center justify-between px-3.5 py-2.5 bg-slate-50 dark:bg-[#141414] border-b border-slate-200 dark:border-white/10">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-slate-800 dark:text-white text-base">psychology</span>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white tracking-wide">MINE GUARDER MASTER AI</h4>
            <span class="px-1.5 py-0.5 rounded text-[8px] font-bold bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/40">SmolLM2 1.7B NEURAL ENGINE</span>
          </div>
          <div class="flex items-center gap-1.5 text-[9px] text-slate-500 dark:text-zinc-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse"></span>
            <span>[SmolLM2 1.7B • 5 NODES • ZERO TOKEN LIMIT • ON-DEVICE]</span>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button ng-click="chat.toggleMaximize()" title="Maximize / Restore Terminal" class="text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white p-1 rounded transition cursor-pointer">
          <span class="material-symbols-outlined text-sm">{{ chat.isMaximized ? 'close_fullscreen' : 'open_in_full' }}</span>
        </button>
        <button ng-click="chat.toggleKeyModal()" title="Cloud Intelligence Uplink Settings" class="text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white p-1 rounded transition cursor-pointer">
          <span class="material-symbols-outlined text-sm">settings</span>
        </button>
        <button id="chat-close-btn" ng-click="chat.closeWindow()" class="text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white p-1 rounded transition cursor-pointer">
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      </div>
    </div>

    <!-- Telemetry Governance Ribbon & Mode Switcher -->
    <div class="flex items-center justify-between px-3 py-1.5 bg-slate-100 dark:bg-[#0f0f0f] border-b border-slate-200 dark:border-white/10 text-[10px] text-slate-600 dark:text-zinc-400">
      <div class="flex items-center gap-1 font-mono">
        <button ng-click="chat.setMode('CHAT')" class="px-2 py-0.5 rounded font-bold transition cursor-pointer" ng-class="chat.activeMode === 'CHAT' ? 'bg-slate-900 text-white dark:bg-white dark:text-black shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white'">
          💬 CHAT ASSISTANT
        </button>
        <button ng-click="chat.setMode('SQL')" class="px-2 py-0.5 rounded font-bold transition cursor-pointer" ng-class="chat.activeMode === 'SQL' ? 'bg-sky-600 text-white dark:bg-cyan-400 dark:text-black shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white'">
          🔍 AI TEXT-TO-SQL
        </button>
      </div>
      <span class="text-slate-900 dark:text-white font-mono text-[9px] font-bold uppercase">{{ chat.activeMode === 'SQL' ? 'SQL ENGINE ACTIVE' : 'INTERLOCK READY' }}</span>
    </div>

      <!-- Quick-Action Macro Chips for Active Mode -->
      <div class="px-3 pt-2 pb-1.5 bg-slate-50 dark:bg-[#0e0e0e] border-b border-slate-200 dark:border-white/10" ng-if="chat.activeMode === 'CHAT'">
        <div class="flex items-center justify-between text-[9px] font-mono text-slate-500 dark:text-zinc-500 uppercase mb-1.5">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[11px] text-sky-600 dark:text-cyan-400">psychology</span>
            AI MACRO COMMANDS
          </span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <button ng-click="chat.sendQuickChat('Run DGMS Regulation 124 safety audit and summarize all active violations, sensor alerts, and recommended interventions.')" class="macro-chip">
            <span class="material-symbols-outlined text-[11px]">policy</span> DGMS Reg-124 Audit
          </button>
          <button ng-click="chat.sendQuickChat('Simulate South Pillar 4B collapse scenario: estimate time-to-failure, affected zones, and evacuation priority sequence.')" class="macro-chip danger">
            <span class="material-symbols-outlined text-[11px]">crisis_alert</span> Simulate Collapse
          </button>
          <button ng-click="chat.sendQuickChat('Check LoRa SX1278 RSSI health for all 5 nodes: flag any nodes with RSSI worse than -90dBm and recommend antenna re-positioning.')" class="macro-chip">
            <span class="material-symbols-outlined text-[11px]">cell_tower</span> LoRa RSSI Check
          </button>
        </div>
      </div>

      <!-- Quick SQL Query Chips when SQL Mode is active -->
      <div class="px-3 pt-2 pb-1.5 bg-sky-50/50 dark:bg-cyan-950/20 border-b border-sky-100 dark:border-cyan-500/20" ng-if="chat.activeMode === 'SQL'">
        <div class="flex items-center justify-between text-[9px] font-mono text-sky-700 dark:text-cyan-400 uppercase mb-1.5 font-bold">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[11px]">database</span>
            NATURAL LANGUAGE SQL EXAMPLES
          </span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <button ng-click="chat.messageInput = 'Show all incident alerts in Sector 4B'; chat.sendMessage();" class="macro-chip">
            <span class="material-symbols-outlined text-[11px]">warning</span> Incident Alerts
          </button>
          <button ng-click="chat.messageInput = 'List active underground miners and their SCSR status'; chat.sendMessage();" class="macro-chip">
            <span class="material-symbols-outlined text-[11px]">engineering</span> Underground Miners
          </button>
          <button ng-click="chat.messageInput = 'Find max roof displacement and average seismic RMS'; chat.sendMessage();" class="macro-chip">
            <span class="material-symbols-outlined text-[11px]">analytics</span> Roof &amp; Seismic Stats
          </button>
          <button ng-click="chat.messageInput = 'Show all DGMS Form IV safety audits'; chat.sendMessage();" class="macro-chip">
            <span class="material-symbols-outlined text-[11px]">verified</span> DGMS Audits
          </button>
        </div>
      </div>

    <div class="px-3 py-1.5 bg-slate-50 dark:bg-[#121212] border-b border-slate-200 dark:border-white/10 flex flex-col gap-1">
      <div class="flex items-center justify-between text-[9px] font-bold font-mono">
        <span class="text-slate-800 dark:text-white flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-600 dark:bg-white animate-ping"></span>
          <span>⚡ OPERATOR INTERFERENCE (1-CLICK OVERRIDES)</span>
        </span>
        <span class="text-slate-500 dark:text-zinc-400 text-[8px] uppercase tracking-wider">Direct Physical Interlocks</span>
      </div>
      <div class="flex gap-1.5 overflow-x-auto scrollbar-none py-0.5 whitespace-nowrap">
        <button ng-click="chat.sendQuickChat('INTERVENE: Trigger Klaxon Evacuation')" class="px-2 py-0.5 rounded bg-white dark:bg-white/10 hover:bg-slate-100 dark:hover:bg-white/20 border border-slate-200 dark:border-white/30 text-slate-800 dark:text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer shadow-xs">
          <span class="material-symbols-outlined text-xs text-rose-600 dark:text-white">warning</span> 🚨 Evacuate Klaxon
        </button>
        <button ng-click="chat.sendQuickChat('INTERVENE: 100% Ventilation Boost')" class="px-2 py-0.5 rounded bg-white dark:bg-white/10 hover:bg-slate-100 dark:hover:bg-white/20 border border-slate-200 dark:border-white/30 text-slate-800 dark:text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer shadow-xs">
          <span class="material-symbols-outlined text-xs text-sky-600 dark:text-white">mode_fan</span> 💨 100% Vent Boost
        </button>
        <button ng-click="chat.sendQuickChat('INTERVENE: Force 500 GPM Dewatering Pump')" class="px-2 py-0.5 rounded bg-white dark:bg-white/10 hover:bg-slate-100 dark:hover:bg-white/20 border border-slate-200 dark:border-white/30 text-slate-800 dark:text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer shadow-xs">
          <span class="material-symbols-outlined text-xs text-cyan-600 dark:text-white">water_drop</span> 💧 Force Dewatering
        </button>
        <button ng-click="chat.sendQuickChat('INTERVENE: Pre-tension Chocks to 350 Bar')" class="px-2 py-0.5 rounded bg-white dark:bg-white/10 hover:bg-slate-100 dark:hover:bg-white/20 border border-slate-200 dark:border-white/30 text-slate-800 dark:text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer shadow-xs">
          <span class="material-symbols-outlined text-xs text-amber-600 dark:text-white">compress</span> 🛡️ Pre-tension Chocks
        </button>
        <button ng-click="chat.sendQuickChat('INTERVENE: Reset Baseline to STABLE')" class="px-2 py-0.5 rounded bg-white dark:bg-white/10 hover:bg-slate-100 dark:hover:bg-white/20 border border-slate-200 dark:border-white/30 text-slate-800 dark:text-white text-[10px] font-bold flex items-center gap-1 transition cursor-pointer shadow-xs">
          <span class="material-symbols-outlined text-xs text-emerald-600 dark:text-white">restart_alt</span> 🔄 Reset STABLE
        </button>
      </div>
    </div>

    <!-- Tactical Telemetry Inquiries Strip -->
    <div class="flex gap-1.5 px-3 py-1.5 overflow-x-auto bg-slate-100 dark:bg-[#0d0d0d] border-b border-slate-200 dark:border-white/10 text-[10px] scrollbar-none whitespace-nowrap">
      <span class="text-slate-500 dark:text-zinc-500 font-mono text-[9px] self-center mr-1">QUERY:</span>
      <button ng-click="chat.sendQuickChat('What is current mine status?')" class="px-2 py-0.5 rounded bg-white dark:bg-neutral-900 hover:bg-slate-50 dark:hover:bg-white/15 text-slate-800 dark:text-zinc-300 border border-slate-200 dark:border-white/10 transition cursor-pointer shadow-2xs">📊 Mine Status</button>
      <button ng-click="chat.sendQuickChat('Check gas and CO levels')" class="px-2 py-0.5 rounded bg-white dark:bg-neutral-900 hover:bg-slate-50 dark:hover:bg-white/15 text-slate-800 dark:text-zinc-300 border border-slate-200 dark:border-white/10 transition cursor-pointer shadow-2xs">💨 Gas &amp; CO</button>
      <button ng-click="chat.sendQuickChat('Explain current subsidence risk')" class="px-2 py-0.5 rounded bg-white dark:bg-neutral-900 hover:bg-slate-50 dark:hover:bg-white/15 text-slate-800 dark:text-zinc-300 border border-slate-200 dark:border-white/10 transition cursor-pointer shadow-2xs">🏔️ Subsidence</button>
      <button ng-click="chat.sendQuickChat('What are DGMS statutory limits for CO and roof flexure?')" class="px-2 py-0.5 rounded bg-white dark:bg-neutral-900 hover:bg-slate-50 dark:hover:bg-white/15 text-slate-800 dark:text-zinc-300 border border-slate-200 dark:border-white/10 transition cursor-pointer shadow-2xs">📋 DGMS Rules</button>
    </div>

    <!-- Chat Messages Scrollable Feed -->
    <div id="chat-messages" class="flex-1 p-3.5 overflow-y-auto space-y-2.5 bg-slate-50 dark:bg-[#080808]">
      <div ng-repeat="msg in chat.messages track by $index" class="flex flex-col" ng-class="{'items-start': msg.isAi, 'items-end': !msg.isAi}">
        <div class="flex items-center gap-1.5 text-[10px] uppercase font-mono mb-1" ng-class="{'text-amber-700 dark:text-amber-400': msg.isIntervention, 'text-sky-700 dark:text-cyan-400': msg.isAi && !msg.isIntervention, 'text-slate-500 dark:text-zinc-400': !msg.isAi}">
          <span class="font-bold">{{ msg.sender }}</span>
          <span class="bg-slate-200/80 dark:bg-white/5 border border-slate-300 dark:border-white/10 text-[9px] px-1.5 py-0.5 rounded text-slate-600 dark:text-zinc-400" ng-if="msg.isAi">{{ msg.source }}</span>
          <span class="bg-amber-100 dark:bg-amber-500/20 border border-amber-300 dark:border-amber-500 text-amber-800 dark:text-amber-300 text-[9px] px-1.5 py-0.5 rounded font-bold animate-pulse" ng-if="msg.isIntervention">SAFETY INTERVENTION</span>
          <span class="text-slate-400 dark:text-slate-500">• {{ msg.time }}</span>
        </div>

        <!-- Standard Message Text -->
        <div ng-if="!msg.isSqlResult" class="max-w-[90%] rounded-lg px-3.5 py-2 text-xs font-sans whitespace-pre-line leading-relaxed shadow-sm" ng-class="{'bg-amber-50 border border-amber-200 text-amber-950 dark:bg-amber-950/60 dark:border-amber-500/60 dark:text-amber-100': msg.isIntervention, 'bg-white border border-slate-200 text-slate-800 dark:bg-[#141414] dark:border-white/20 dark:text-zinc-100': msg.isAi && !msg.isIntervention, 'bg-sky-50 border border-sky-200 text-sky-950 dark:bg-cyan-950/50 dark:border-cyan-500/40 dark:text-cyan-50': !msg.isAi}">
          {{ msg.text }}
        </div>

        <!-- SQL Query Execution Result Display Block -->
        <div ng-if="msg.isSqlResult" class="max-w-[95%] w-full rounded-lg p-3 bg-white dark:bg-[#121212] border border-sky-200 dark:border-cyan-500/30 text-xs font-mono space-y-2 shadow-sm">
          <div class="flex items-center justify-between text-[10px] text-sky-700 dark:text-cyan-400 font-bold border-b border-slate-200 dark:border-white/10 pb-1.5">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-xs">terminal</span> GENERATED SQL QUERY
            </span>
            <span class="text-slate-500 dark:text-zinc-400 font-normal">{{ msg.executionTimeMs }}ms • {{ msg.rowCount }} row(s)</span>
          </div>
          <div class="bg-slate-900 text-emerald-400 p-2.5 rounded font-mono text-[11px] overflow-x-auto select-all">
            {{ msg.generatedSql }}
          </div>
          <div class="text-slate-700 dark:text-zinc-200 font-sans text-xs leading-relaxed">
            {{ msg.text }}
          </div>
          <details class="text-[10px] text-slate-600 dark:text-zinc-400 pt-1" ng-if="msg.results && msg.results.length > 0">
            <summary class="cursor-pointer hover:text-sky-600 dark:hover:text-cyan-300 font-bold font-mono">View Raw JSON Dataset ({{ msg.rowCount }} items)</summary>
            <pre class="mt-1.5 p-2 bg-slate-100 dark:bg-[#080808] border border-slate-200 dark:border-white/10 rounded overflow-x-auto text-[10px] text-slate-800 dark:text-zinc-300 font-mono max-h-40">{{ msg.results | json }}</pre>
          </details>
        </div>
      </div>
      <div ng-if="chat.isSending" class="flex items-center gap-2 text-xs font-mono text-sky-700 dark:text-cyan-400 py-1 font-bold">
        <span class="w-2 h-2 rounded-full bg-sky-600 dark:bg-cyan-400 animate-ping"></span>
        <span>{{ chat.activeMode === 'SQL' ? 'AI TRANSLATING PROMPT TO SQL & EXECUTING QUERY...' : 'MASTER AI COMPUTING NEURAL DIRECTIVE...' }}</span>
      </div>
    </div>

    <!-- Chat Input Area -->
    <div class="p-2.5 bg-slate-50 dark:bg-[#141414] border-t border-slate-200 dark:border-white/10 flex items-center gap-2">
      <input id="chat-input" type="text" ng-model="chat.messageInput" ng-keydown="$event.keyCode === 13 && chat.sendMessage()" ng-attr-placeholder="{{ chat.activeMode === 'SQL' ? 'Ask a database question (e.g. Show all incident alerts in Sector 4B)...' : 'Command Master AI or enter intervention directive...' }}" class="flex-1 bg-white dark:bg-[#050505] border border-slate-300 dark:border-white/20 focus:border-slate-600 dark:focus:border-white focus:outline-none text-xs text-slate-900 dark:text-white px-3 py-2 rounded-lg font-sans placeholder-slate-400 dark:placeholder-zinc-500 shadow-2xs" />
      <button id="chat-voice-btn" ng-click="chat.startVoiceCommand()" title="Push-to-Talk Voice Command (Speak hands-free)" class="p-2 rounded-lg font-bold transition flex items-center justify-center cursor-pointer active:scale-95" ng-class="chat.isListening ? 'ptt-active' : 'bg-slate-200 hover:bg-slate-300 text-slate-700 dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:text-zinc-300 dark:hover:text-white border border-slate-300 dark:border-white/20'">
        <span class="material-symbols-outlined text-sm">{{ chat.isListening ? 'mic' : 'mic_none' }}</span>
      </button>
      <button id="chat-send-btn" ng-click="chat.sendMessage()" class="bg-slate-900 hover:bg-black text-white dark:bg-white dark:hover:bg-zinc-200 dark:text-black p-2 rounded-lg font-bold transition flex items-center justify-center cursor-pointer active:scale-95 shadow-xs">
        <span class="material-symbols-outlined text-sm">{{ chat.activeMode === 'SQL' ? 'search' : 'send' }}</span>
      </button>
    </div>
  </div>

  <!-- Cloud Settings & API Configuration Modal -->
  <div id="gemini-key-modal" ng-show="chat.isKeyModalOpen" class="absolute bottom-16 right-0 w-80 sm:w-96 p-4 rounded-xl bg-white dark:bg-[#0a0a0a] border border-slate-200 dark:border-white/20 shadow-2xl backdrop-blur-xl z-50">
    <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-200 dark:border-white/10">
      <div class="flex items-center gap-2 text-xs font-bold text-slate-900 dark:text-white">
        <span class="material-symbols-outlined text-slate-800 dark:text-white text-base">cloud_sync</span>
        <span>CLOUD BACKEND &amp; AI SETTINGS</span>
      </div>
      <button ng-click="chat.toggleKeyModal()" class="text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white cursor-pointer">
        <span class="material-symbols-outlined text-sm">close</span>
      </button>
    </div>
    <div class="space-y-3">
      <div>
        <label class="block text-[11px] font-bold text-slate-700 dark:text-zinc-300 mb-1">Live Cloud Backend URL (Optional)</label>
        <p class="text-[10px] text-slate-500 dark:text-zinc-400 leading-tight mb-1.5">
          Connect to a live hosted Node.js server (e.g. Cloudflare Tunnel, Railway, Cloud Run, Render):
        </p>
        <input id="backend-url-input" type="text" ng-model="chat.backendUrlInput" placeholder="https://your-tunnel.trycloudflare.com" class="w-full bg-slate-50 dark:bg-[#141414] border border-slate-300 dark:border-white/20 text-xs text-slate-900 dark:text-white px-3 py-2 rounded focus:outline-none focus:border-slate-600 dark:focus:border-white font-mono" />
      </div>
      <div>
        <label class="block text-[11px] font-bold text-slate-700 dark:text-zinc-300 mb-1">Google Gemini API Key (Optional)</label>
        <p class="text-[10px] text-slate-500 dark:text-zinc-400 leading-tight mb-1.5">
          Amplify Master AI with frontier direct reasoning:
        </p>
        <input id="gemini-key-input" type="password" ng-model="chat.apiKeyInput" placeholder="AIzaSy..." class="w-full bg-slate-50 dark:bg-[#141414] border border-slate-300 dark:border-white/20 text-xs text-slate-900 dark:text-white px-3 py-2 rounded focus:outline-none focus:border-slate-600 dark:focus:border-white font-mono" />
      </div>
    </div>
    <div class="flex items-center justify-end gap-2 text-xs font-mono mt-4">
      <button ng-click="chat.toggleKeyModal()" class="px-3 py-1.5 text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white transition cursor-pointer">Cancel</button>
      <button ng-click="chat.saveSettings()" class="px-3 py-1.5 bg-slate-900 hover:bg-black text-white dark:bg-white dark:text-black font-bold rounded dark:hover:bg-zinc-200 transition cursor-pointer shadow-xs">Save &amp; Connect</button>
    </div>
  </div>
</div>
