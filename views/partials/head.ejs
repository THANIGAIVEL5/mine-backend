<!-- CesiumJS Photorealistic 3D Globe Engine (God's Eye View - Bilawal Sidhu) -->
<link href="https://cesium.com/downloads/cesiumjs/releases/1.119/Build/Cesium/Widgets/widgets.css" rel="stylesheet">
<script src="https://cesium.com/downloads/cesiumjs/releases/1.119/Build/Cesium/Cesium.js"></script>
<style>
  /* God's Eye View Optical Shader Overlays */
  .optic-flir {
    filter: contrast(180%) invert(85%) hue-rotate(180deg) saturate(250%) brightness(1.1);
  }
  .optic-nvg {
    filter: contrast(160%) sepia(100%) hue-rotate(75deg) saturate(600%) brightness(1.15);
  }
  .optic-crt {
    filter: contrast(170%) brightness(0.85) grayscale(80%) sepia(20%) hue-rotate(110deg);
  }
  .cesium-viewer-bottom, .cesium-credit-logoContainer, .cesium-credit-expand-link {
    display: none !important;
  }
  .cesium-widget, .cesium-widget canvas {
    width: 100% !important;
    height: 100% !important;
    touch-action: none;
  }
</style>
