                <!-- Log Entry 2: Rule Trigger -->
                <div class="bg-[#07090e] border border-amber-500/30 p-2.5 rounded flex items-start gap-2.5">
                  <div class="w-6 h-6 rounded bg-amber-500/20 border border-amber-500/40 flex items-center justify-center flex-shrink-0 mt-0.5">
