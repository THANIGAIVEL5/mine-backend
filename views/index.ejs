  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    socket.on('telemetry', (data) => {
      const el = (id) => document.getElementById(id);
      if (el('latency-val')) el('latency-val').innerHTML = `${data.latency}<span class="text-[11px] text-cyan-400 font-normal ml-1">MS</span>`;
      if (el('rssi-val')) el('rssi-val').innerText = data.rssi;
      if (el('pkt-val')) el('pkt-val').innerText = data.pkt;
      
      if (el('val-pitch')) el('val-pitch').innerText = `${data.pitch.toFixed(2)}°`;
      if (el('val-roll')) el('val-roll').innerText = `${data.roll > 0 ? '+' : ''}${data.roll.toFixed(2)}°`;
      if (el('val-disp')) el('val-disp').innerText = `${data.disp.toFixed(2)}° Σ`;
      
      if (el('val-rms')) el('val-rms').innerText = `${data.rms.toFixed(2)} g`;
      if (el('val-p2p')) el('val-p2p').innerText = `${data.p2p.toFixed(2)} g`;
      if (el('val-fft')) el('val-fft').innerText = `${data.fft.toFixed(1)} Hz`;
      
      if (el('val-temp')) el('val-temp').innerText = data.temp.toFixed(1);
      if (el('temp-bar')) {
        const tempPct = Math.max(0, Math.min(100, (data.temp / 70) * 100));
        el('temp-bar').style.height = `${tempPct}%`;
      }
      
      if (el('tilt-warning')) {
        if (Math.abs(data.pitch) > 5.0 || Math.abs(data.roll) > 5.0) {
          el('tilt-warning').classList.remove('opacity-0');
        } else {
          el('tilt-warning').classList.add('opacity-0');
        }
      }
      
      if (el('val-aqi')) el('val-aqi').innerText = data.aqi;
      if (el('aqi-ring')) {
        const ringVal = Math.min(290, (data.aqi / 300) * 290);
        el('aqi-ring').setAttribute('stroke-dasharray', `${ringVal} 360`);
        if (data.aqi > 150) el('aqi-ring').setAttribute('stroke', '#ffba27');
        if (data.aqi > 250) el('aqi-ring').setAttribute('stroke', '#ff3366');
      }
      if (el('aqi-band')) {
        if (data.aqi > 250) el('aqi-band').innerText = 'CRITICAL BAND';
        else if (data.aqi > 150) el('aqi-band').innerText = 'UNHEALTHY BAND';
        else el('aqi-band').innerText = 'NOMINAL BAND';
      }
      
      if (el('val-co')) el('val-co').innerText = `${data.co} ppm`;
      if (el('val-nh3')) el('val-nh3').innerText = `${data.nh3} ppm`;
      if (el('val-co2')) el('val-co2').innerText = `${data.co2} ppm`;
      
      if (el('val-sump')) el('val-sump').innerText = data.sump.toFixed(2);
      if (el('sump-fill')) {
        const sumpPct = Math.max(0, Math.min(100, (data.sump / 4.0) * 100));
        el('sump-fill').style.height = `${sumpPct}%`;
      }

      // Animate the SVG artificial horizon based on live pitch & roll
      const horizon = el('horizon-dynamic-group');
      if (horizon) {
        // pitch is mapped to Y translation, roll is mapped to rotation
        horizon.setAttribute('transform', `rotate(${data.roll.toFixed(2)} 80 80) translate(0, ${(-data.pitch * 3).toFixed(2)})`);
      }
      
      // Phase 1: ML Anomaly Score Calculation
      const anomalyScore = Math.min(1.0, (Math.abs(data.pitch) * 0.1) + (data.rms * 1.5) + (data.co * 0.01)).toFixed(2);
      if (el('iso-score')) {
        el('iso-score').innerText = anomalyScore;
        const pct = Math.floor(anomalyScore * 100);
        el('iso-text').innerText = `${pct}%`;
        el('iso-gauge').setAttribute('stroke-dasharray', `${pct}, 100`);
      }

      // Rule Bars mapping
      if (el('rule-1-bar')) el('rule-1-bar').style.width = `${Math.min(100, Math.abs(data.pitch) * 20)}%`;
      if (el('rule-2-bar')) el('rule-2-bar').style.width = `${Math.min(100, data.rms * 200)}%`;
      if (el('rule-3-bar')) el('rule-3-bar').style.width = `${Math.min(100, (data.co / 30) * 100)}%`;

      // Phase 2: Dynamic Tactical Map Visualization
      if (el('node-03-ping')) el('node-03-ping').style.animationDuration = `${Math.max(0.2, 1.5 - data.rms * 2)}s`;
      if (el('node-03-dot')) {
        const intense = data.rms > 0.3 ? 'shadow-[0_0_24px_#ff0033]' : 'shadow-[0_0_16px_#ff3366]';
        el('node-03-dot').className = `w-4 h-4 rounded-full bg-[#ff3366] ${intense} border-2 border-white transition-all duration-500`;
      }
      
      if (el('subsidence-trail') && el('subsidence-arrow')) {
        const dx = data.disp * 2;
        const dy = data.disp * 2;
        el('subsidence-trail').setAttribute('d', `M 368,212 L 374,218 L ${382+dx},${224+dy} L ${390+dx},${230+dy}`);
        el('subsidence-arrow').setAttribute('transform', `translate(${dx}, ${dy})`);
      }
    });

    // Waveform Oscilloscope Animation Loop
    let waveOffset = 0;
    let currentRms = 0.15;
    socket.on('telemetry', (data) => { currentRms = data.rms; });

    setInterval(() => {
      waveOffset -= 5;
      let pathData = "M 0,80 ";
      let maxAmp = 0;
      let maxX = 0;
      
      for(let x = 0; x <= 320; x += 10) {
        // Create a noisy sine wave based on RMS
        const amp = (Math.sin((x + waveOffset) * 0.05) * 10) + ((Math.random() - 0.5) * currentRms * 150);
        const y = 80 + amp;
        pathData += `L ${x},${y} `;
        
        if (Math.abs(amp) > Math.abs(maxAmp)) {
          maxAmp = amp;
          maxX = x;
        }
      }
      
      const waveGlow = document.getElementById('wave-glow');
      const waveCore = document.getElementById('wave-core');
      if (waveGlow && waveCore) {
        waveGlow.setAttribute('d', pathData);
        waveCore.setAttribute('d', pathData);
        
        // Update peak dot
        const dot = document.getElementById('wave-peak-dot');
        const line = document.getElementById('wave-peak-line');
        const text = document.getElementById('wave-peak-text');
        if (dot) {
          const peakY = 80 + maxAmp;
          dot.setAttribute('cx', maxX);
          dot.setAttribute('cy', peakY);
          line.setAttribute('x1', maxX);
          line.setAttribute('x2', maxX);
          line.setAttribute('y1', peakY);
          line.setAttribute('y2', Math.max(10, peakY - 18));
          text.setAttribute('x', maxX + 6);
          text.setAttribute('y', Math.max(18, peakY - 10));
          text.textContent = `MAX ${(Math.abs(maxAmp)/100).toFixed(2)}g`;
        }
      }
    }, 50);

    // Live micro-clock and telemetry updates
    setInterval(() => {
      const d = new Date();
      const timeStr = d.toLocaleTimeString('en-US', { hour12: false }) + ' IST';
      const clockEl = document.getElementById('live-clock');
      if (clockEl) clockEl.innerText = timeStr + ' UTC+5:30 REAL-TIME';
    }, 1000);

    // Basic Auth Integration Test
    document.addEventListener('DOMContentLoaded', () => {
      const token = localStorage.getItem('token');
      if (!token) {
        console.log('No token found. Attempting registration test...');
        fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: 'admin', password: 'password123' })
        })
        .then(res => res.json())
        .then(data => {
          console.log('Register response:', data);
          return fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: 'admin', password: 'password123' })
          });
        })
        .then(res => res.json())
        .then(data => {
          console.log('Login response:', data);
          if (data.token) {
            localStorage.setItem('token', data.token);
            console.log('Token saved to localStorage');
          }
        })
        .catch(err => console.error('Auth error:', err));
      } else {
        console.log('User is authenticated with token:', token);
      }
    });

    // Real-Time Chat Assistant Logic
    const chatToggleBtn = document.getElementById('chat-toggle-btn');
    const chatWindow = document.getElementById('chat-window');
    const chatCloseBtn = document.getElementById('chat-close-btn');
    const chatMessages = document.getElementById('chat-messages');
    const chatInput = document.getElementById('chat-input');
    const chatSendBtn = document.getElementById('chat-send-btn');
    const chatBadge = document.getElementById('chat-badge');

    if (chatToggleBtn && chatWindow) {
      chatToggleBtn.addEventListener('click', () => {
        chatWindow.classList.toggle('hidden');
        if (!chatWindow.classList.contains('hidden')) {
          chatInput.focus();
          if (chatBadge) chatBadge.classList.add('hidden');
        }
      });

      chatCloseBtn.addEventListener('click', () => {
        chatWindow.classList.add('hidden');
      });
    }

    function appendMessage(sender, text, isAi = false, time = '') {
      if (!chatMessages) return;
      const msgDiv = document.createElement('div');
      msgDiv.className = `flex flex-col ${isAi ? 'items-start' : 'items-end'} mb-3`;
      
      const timeStr = time || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const senderColor = isAi ? 'text-[#00f5ff]' : 'text-emerald-400';
      const bubbleBg = isAi ? 'bg-[#151922] border border-[#00f5ff]/30 text-slate-100' : 'bg-emerald-950/70 border border-emerald-500/40 text-emerald-100';

      msgDiv.innerHTML = `
        <div class="flex items-center gap-1.5 text-[10px] uppercase font-mono ${senderColor} mb-1">
          <span>${sender}</span>
          <span class="text-slate-500">• ${timeStr}</span>
        </div>
        <div class="max-w-[85%] rounded-lg px-3.5 py-2 text-xs font-sans whitespace-pre-line leading-relaxed shadow-lg ${bubbleBg}">
          ${text}
        </div>
      `;
      chatMessages.appendChild(msgDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function sendUserChatMessage(customText = null) {
      const text = customText || (chatInput ? chatInput.value.trim() : '');
      if (!text) return;
      if (chatInput) chatInput.value = '';

      // Send via WebSocket if connected
      if (typeof socket !== 'undefined' && socket.connected) {
        socket.emit('chat_message', { message: text, user: 'Mine Operator' });
      } else {
        // Fallback to REST API
        appendMessage('Mine Operator', text, false);
        fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text })
        })
        .then(res => res.json())
        .then(data => {
          appendMessage('TERRA-SENTINEL AI', data.reply, true);
        })
        .catch(err => {
          appendMessage('TERRA-SENTINEL AI', 'Communication error: ' + err.message, true);
        });
      }
    }

    if (chatSendBtn) {
      chatSendBtn.addEventListener('click', () => sendUserChatMessage());
    }
    if (chatInput) {
      chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') sendUserChatMessage();
      });
    }

    // Handle incoming chat broadcasts from server
    if (typeof socket !== 'undefined') {
      socket.on('chat_broadcast', (data) => {
        appendMessage(data.sender, data.text, data.isAi, data.timestamp);
        if (chatWindow && chatWindow.classList.contains('hidden') && chatBadge) {
          chatBadge.classList.remove('hidden');
        }
      });
    }

    window.sendQuickChat = function(query) {
      if (chatWindow && chatWindow.classList.contains('hidden')) {
        chatWindow.classList.remove('hidden');
      }
      sendUserChatMessage(query);
    };
  </script>

  <!-- Floating Cyber HUD AI Chat Assistant Widget -->
  <div class="fixed bottom-5 right-5 z-50 font-mono">
    <!-- Chat Toggle Button -->
    <button id="chat-toggle-btn" class="relative flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-[#0a0e17]/90 border border-[#00f5ff]/60 text-[#00f5ff] hover:bg-[#00f5ff]/10 hover:border-[#00f5ff] transition-all shadow-[0_0_20px_rgba(0,245,255,0.3)] backdrop-blur-md">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00f5ff] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#00f5ff]"></span>
      </span>
      <span class="material-symbols-outlined text-lg">smart_toy</span>
      <span class="text-xs font-bold tracking-wider uppercase">Terra AI Chat</span>
      <span id="chat-badge" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full border-2 border-[#0a0e17]"></span>
    </button>

    <!-- Chat Modal Window -->
    <div id="chat-window" class="hidden absolute bottom-14 right-0 w-80 sm:w-96 h-[460px] rounded-xl bg-[#0a0e17]/95 border border-[#00f5ff]/40 shadow-[0_0_30px_rgba(0,0,0,0.8)] backdrop-blur-xl flex flex-col overflow-hidden">
      <!-- Chat Header -->
      <div class="flex items-center justify-between px-3.5 py-2.5 bg-[#151922] border-b border-[#00f5ff]/20">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[#00f5ff] text-base">psychology</span>
          <div>
            <h4 class="text-xs font-bold text-white tracking-wide">SENTINEL AI CHAT</h4>
            <div class="flex items-center gap-1.5 text-[9px] text-[#00f5ff]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>GEOTECHNICAL ADVISOR ACTIVE</span>
            </div>
          </div>
        </div>
        <button id="chat-close-btn" class="text-slate-400 hover:text-white p-1 rounded transition">
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      </div>

      <!-- Quick Action Chips -->
      <div class="flex gap-1.5 px-3 py-2 overflow-x-auto bg-[#0f131c]/60 border-b border-slate-800 text-[10px] scrollbar-none whitespace-nowrap">
        <button onclick="sendQuickChat('What is current mine status?')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-[#00f5ff]/20 hover:text-[#00f5ff] text-slate-300 transition">📊 Mine Status</button>
        <button onclick="sendQuickChat('Check gas and CO levels')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-[#00f5ff]/20 hover:text-[#00f5ff] text-slate-300 transition">💨 Gas & CO</button>
        <button onclick="sendQuickChat('What is the emergency evacuation protocol?')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-red-500/20 hover:text-red-400 text-slate-300 transition">🚨 Evacuation</button>
        <button onclick="sendQuickChat('Explain current subsidence risk')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-[#00f5ff]/20 hover:text-[#00f5ff] text-slate-300 transition">🏔️ Subsidence</button>
      </div>

      <!-- Chat Messages Scrollable Feed -->
      <div id="chat-messages" class="flex-1 p-3.5 overflow-y-auto space-y-2">
        <div class="flex flex-col items-start mb-3">
          <div class="flex items-center gap-1.5 text-[10px] uppercase font-mono text-[#00f5ff] mb-1">
            <span>TERRA-SENTINEL AI</span>
            <span class="text-slate-500">• LIVE</span>
          </div>
          <div class="max-w-[85%] rounded-lg px-3.5 py-2 text-xs font-sans leading-relaxed bg-[#151922] border border-[#00f5ff]/30 text-slate-100 shadow-lg">
            Welcome Operator. I am your real-time Geotechnical & Strata Safety AI. Ask any questions about current sensor readings, gas thresholds, or emergency protocols.
          </div>
        </div>
      </div>

      <!-- Chat Input Area -->
      <div class="p-2.5 bg-[#151922] border-t border-[#00f5ff]/20 flex items-center gap-2">
        <input id="chat-input" type="text" placeholder="Ask Geotechnical AI..." class="flex-1 bg-[#0a0e17] border border-slate-700 focus:border-[#00f5ff] focus:outline-none text-xs text-white px-3 py-2 rounded-lg font-sans placeholder-slate-500" />
        <button id="chat-send-btn" class="bg-[#00f5ff] hover:bg-[#00f5ff]/80 text-[#0a0e17] p-2 rounded-lg font-bold transition flex items-center justify-center shadow-[0_0_10px_rgba(0,245,255,0.4)]">
          <span class="material-symbols-outlined text-sm">send</span>
        </button>
      </div>
    </div>
  </div>
</body>
