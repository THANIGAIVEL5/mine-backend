            <!-- Quick Dispatch Controls -->
            <div class="flex items-center gap-2 mt-3">
              <button onclick="alert('AUDIT LOG RE-DISPATCHED to DGMS central monitoring server.');" class="flex-1 bg-[#151c2c] hover:bg-cyan-950 border border-cyan-500/30 text-cyan-300 font-['JetBrains_Mono'] text-[11px] py-2 rounded uppercase font-bold flex items-center justify-center gap-1.5 transition-all">
                <span class="material-symbols-outlined text-[14px]">send</span> RE-DISPATCH AUDIT LOG
              </button>
              <button onclick="window.print();" class="bg-[#00f5ff] hover:bg-cyan-300 text-black font-['JetBrains_Mono'] text-[11px] px-4 py-2 rounded uppercase font-bold transition-all shadow-[0_0_12px_rgba(0,245,255,0.5)]">
