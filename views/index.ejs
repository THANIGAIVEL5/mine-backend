<!DOCTYPE html>
<html class="light" lang="en" ng-app="terraPulseApp">
<head>
  <%- include('partials/head', { title: 'MINE GUARDER OS - Live Telemetry & GIS | SIH 2026' }) %>
</head>
<body ng-controller="TelemetryDashboardController as vm" ng-cloak ng-class="{'hazard-critical-iv': vm.telemetry.pitch > 3.0}" class="bg-slate-50 dark:bg-[#07090e] font-['Space_Grotesk'] text-[13px] text-slate-800 dark:text-on-surface antialiased selection:bg-primary-container selection:text-black min-h-screen relative overflow-x-hidden">
  <div class="fixed inset-0 pointer-events-none bg-[radial-gradient(circle_at_25%_15%,rgba(2,132,199,0.03),transparent_45%),radial-gradient(circle_at_80%_25%,rgba(225,29,72,0.03),transparent_40%),radial-gradient(circle_at_50%_75%,rgba(241,245,249,0.8),transparent_50%)] dark:bg-[radial-gradient(circle_at_25%_15%,rgba(255,255,255,0.03),transparent_45%),radial-gradient(circle_at_80%_25%,rgba(255,51,102,0.05),transparent_40%),radial-gradient(circle_at_50%_75%,rgba(255,255,255,0.02),transparent_50%)] z-0"></div>

  <!-- Left Tactical Sidebar -->
  <%- include('partials/sidebar', { activePage: 'live' }) %>

  <!-- Main Content wrapper -->
  <div class="pl-64 relative z-10">
    <%- include('partials/header', { systemMode: 'SYSTEM MODE: REALTIME CONTINUOUS INGESTION', targetGeometry: 'TARGET GEOMETRY: DRIFT & SHAFT 12' }) %>

    <main class="relative pt-24 w-full px-6 bg-slate-50 dark:bg-[#07090e]">
      <div class="flex flex-col w-full pb-12 gap-4">
        
        <!-- TOP OVERALL SITE RISK BANNER & LIVE METRICS -->
        <div class="hud-bracket flex flex-col xl:flex-row items-stretch justify-between gap-3 bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md p-3.5 rounded-xl border border-slate-200 dark:border-white/20 shadow-xs">
          <!-- Hazard Banner Alert -->
          <div class="hud-bracket-danger relative flex items-center gap-3 bg-rose-50 dark:bg-gradient-to-r dark:from-[#ff3366]/20 dark:via-[#ff3366]/10 dark:to-transparent p-3.5 rounded-lg border border-rose-200 dark:border-[#ff3366]/40 flex-1 overflow-hidden shadow-xs">
            <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-rose-500/5 rounded-full blur-lg pointer-events-none"></div>
            <div class="relative flex items-center justify-center w-9 h-9 rounded-lg bg-rose-100 dark:bg-[#ff3366]/20 border border-rose-200 dark:border-[#ff3366]/60 text-rose-700 dark:text-[#ff3366] flex-shrink-0 shadow-xs">
              <span class="material-symbols-outlined text-[22px] animate-ping absolute opacity-50">warning</span>
              <span class="material-symbols-outlined text-[20px]">warning</span>
            </div>
            <div class="flex flex-col min-w-0">
              <div class="flex items-center gap-2">
                <span class="font-['JetBrains_Mono'] text-[10px] uppercase text-rose-700 dark:text-[#ff3366] tracking-widest font-extrabold">HAZARD LEVEL IV CRITICAL TRIGGER</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-slate-500 dark:text-on-surface-variant font-semibold">| ZONE SEC-4B</span>
              </div>
              <div class="font-['Space_Grotesk'] text-[15px] text-slate-900 dark:text-white tracking-tight font-extrabold truncate mt-0.5">
                ALERT: SHAFT 4B SOUTH PILLAR TILT EXCURSION (+{{ vm.telemetry.pitch | number:2 }}° Δ, Vibration Spike {{ vm.telemetry.fft | number:0 }}Hz)
              </div>
            </div>
          </div>
          
          <!-- Live Telemetry Counters strip -->
          <div class="flex flex-wrap items-center gap-3 bg-slate-50 dark:bg-[#07090e]/80 border border-slate-200 dark:border-white/5 px-4 py-2 rounded-lg">
            <!-- Node Count -->
            <div class="flex flex-col px-1">
              <span class="font-['JetBrains_Mono'] text-[9px] uppercase tracking-wider text-slate-500 dark:text-on-surface-variant font-semibold">NODES ONLINE</span>
              <div class="flex items-baseline gap-1">
                <span class="font-['JetBrains_Mono'] text-[20px] text-sky-700 dark:text-primary font-bold">{{ vm.nodes.length }}</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-slate-500 dark:text-on-surface-variant">/ 5</span>
              </div>
            </div>
            <div class="w-px h-7 bg-slate-200 dark:bg-white/20"></div>
            <!-- RSSI -->
            <div class="flex flex-col px-1">
              <span class="font-['JetBrains_Mono'] text-[9px] uppercase tracking-wider text-slate-500 dark:text-on-surface-variant font-semibold">SX1278 RSSI</span>
              <div class="flex items-baseline gap-1">
                <span class="font-['JetBrains_Mono'] text-[20px] text-slate-900 dark:text-white font-bold" id="rssi-val">{{ vm.rssi }}</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-on-surface-variant font-semibold">dBM AVG</span>
              </div>
            </div>
            <div class="w-px h-7 bg-slate-200 dark:bg-white/20"></div>
            <!-- Packet rate -->
            <div class="flex flex-col px-1">
              <span class="font-['JetBrains_Mono'] text-[9px] uppercase tracking-wider text-slate-500 dark:text-on-surface-variant font-semibold">PACKET FLOW</span>
              <div class="flex items-baseline gap-1">
                <span class="font-['JetBrains_Mono'] text-[20px] text-amber-700 dark:text-secondary font-bold" id="pkt-val">{{ (vm.packetRate * 42) | number:0 }}</span>
                <span class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-on-surface-variant font-semibold">PKT/MIN</span>
              </div>
            </div>
            <div class="w-px h-7 bg-slate-200 dark:bg-white/20"></div>
            <!-- Ingestion state -->
            <div class="flex flex-col px-1">
              <span class="font-['JetBrains_Mono'] text-[9px] uppercase tracking-wider text-slate-500 dark:text-on-surface-variant font-semibold">TELEMETRY UPLINK</span>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span id="ingest-ping-dot" class="w-2 h-2 rounded-full" ng-class="vm.connected ? 'bg-emerald-600 shadow-[0_0_8px_#10b981] animate-pulse' : 'bg-rose-500 shadow-[0_0_8px_#ef4444]'"></span>
                <span id="ingest-channel-text" class="font-['JetBrains_Mono'] text-[11px] uppercase font-bold" ng-class="vm.connected ? 'text-emerald-700 dark:text-emerald-400' : 'text-rose-700 dark:text-rose-400'">LIVE STREAM: {{ vm.connectionType }}</span>
              </div>
            </div>
            <div class="w-px h-7 bg-slate-200 dark:bg-white/20"></div>
            <!-- Ingestion monitor badge -->
            <div id="connection-health-badge" class="flex items-center gap-2 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 px-3 py-1.5 rounded-lg">
              <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-[18px]">cloud_done</span>
              <div class="flex flex-col">
                <span class="font-['JetBrains_Mono'] text-[9px] text-emerald-800 dark:text-emerald-400 font-bold uppercase tracking-wider">NETWORK STATUS: OPTIMAL</span>
                <span id="connection-node-summary" class="font-['JetBrains_Mono'] text-[10px] leading-tight text-slate-600 dark:text-zinc-300 font-medium">ALL 5 NODES REPORTING REALTIME</span>
              </div>
            </div>
          </div>
        </div>

        <!-- MINER PERSONNEL HEADCOUNT STRIP -->
        <div class="hud-bracket bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md border border-slate-200 dark:border-white/20 rounded-xl px-4 py-3 flex flex-col gap-2 shadow-xs">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="miner-dot"></span>
              <span class="font-['JetBrains_Mono'] text-[11px] uppercase font-bold text-slate-800 dark:text-white tracking-wider">CHASNALA PERSONNEL TRACKER — {{ vm.totalMiners }} MINERS ACTIVE UNDERGROUND</span>
              <span ng-if="vm.evacuationInProgress" class="font-['JetBrains_Mono'] text-[10px] font-extrabold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/40 px-2 py-0.5 rounded">MUSTER: {{ vm.evacuatedCount }}/{{ vm.totalMiners }} ACCOUNTED</span>
            </div>
            <button ng-if="!vm.evacuationInProgress" ng-click="vm.startEvacuationHeadcount()" class="font-['JetBrains_Mono'] text-[10px] uppercase font-bold px-2.5 py-1 rounded-lg bg-amber-50 dark:bg-amber-500/15 border border-amber-300 dark:border-amber-500/40 text-amber-800 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-500/25 transition cursor-pointer active:scale-95">
              MUSTER DRILL
            </button>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <div ng-repeat="p in vm.personnel" class="sector-badge" ng-class="p.critical ? 'danger' : ''">
              <div class="flex items-center gap-1.5">
                <span class="miner-dot" ng-class="p.critical ? 'critical' : ''"></span>
                <span class="font-['JetBrains_Mono'] text-[9px] uppercase font-semibold text-slate-500 dark:text-zinc-400">{{ p.zone }}</span>
              </div>
              <span class="font-['JetBrains_Mono'] text-[18px] font-black" ng-class="p.critical ? 'text-rose-600 dark:text-rose-400' : 'text-slate-900 dark:text-white'">{{ p.count }}</span>
              <span class="font-['Space_Grotesk'] text-[9px] text-slate-500 dark:text-zinc-400 text-center leading-tight">{{ p.sector }}</span>
            </div>
            <!-- Total Muster Box -->
            <div class="sector-badge ml-auto bg-slate-100 dark:bg-white/5 border-slate-300 dark:border-white/20">
              <span class="font-['JetBrains_Mono'] text-[9px] uppercase font-semibold text-slate-500 dark:text-zinc-400">TOTAL</span>
              <span class="font-['JetBrains_Mono'] text-[22px] font-black text-slate-900 dark:text-white">{{ vm.totalMiners }}</span>
              <span class="font-['Space_Grotesk'] text-[9px] text-slate-500 dark:text-zinc-400">Underground</span>
            </div>
          </div>
        </div>

        <!-- FORENSIC INCIDENT BLACK BOX REPLAY BAR -->
        <div ng-if="vm.isReplayMode" class="bg-amber-50 dark:bg-amber-950/80 border border-amber-200 dark:border-amber-500/60 p-3.5 rounded-xl flex flex-col gap-2.5 shadow-xs">
          <div class="flex items-center justify-between font-['JetBrains_Mono'] text-[11px] text-amber-800 dark:text-amber-300">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-ping"></span>
              <span class="font-extrabold tracking-wider uppercase">FORENSIC BLACK BOX REPLAY MODE: CHASNALA SEC-4B INCIDENT INVESTIGATION</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-500 dark:text-zinc-400">TIMELINE OFFSET:</span>
              <span class="font-extrabold text-amber-900 dark:text-amber-300">-{{ (20 - vm.replayIndex) * 45 }} SECONDS</span>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[11px] text-slate-500 dark:text-zinc-400 font-['JetBrains_Mono'] font-medium">T-15m (Baseline)</span>
            <input type="range" min="0" max="20" ng-model="vm.replayIndex" ng-change="vm.scrubReplay(vm.replayIndex)" class="flex-1 accent-amber-600 cursor-pointer h-2 bg-slate-200 dark:bg-neutral-900 rounded-full" />
            <span class="text-[11px] text-rose-600 dark:text-rose-400 font-['JetBrains_Mono'] font-extrabold">T-0 (ROOF BURST)</span>
            <button ng-click="vm.toggleReplay()" class="px-3.5 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-[11px] font-['JetBrains_Mono'] transition active:scale-95 shadow-sm cursor-pointer">RESUME LIVE</button>
          </div>
        </div>

        <!-- MAIN HUD GRID: MAP + NODE FOCUS SELECTOR -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-4">
          <!-- LEFT & CENTER: GIS TACTICAL MINE MAP (8 COLS) -->
          <div class="hud-bracket xl:col-span-8 flex flex-col bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md rounded-xl border border-slate-200 dark:border-white/20 overflow-hidden shadow-sm">
            <!-- Map Header Rail -->
            <div class="flex flex-wrap items-center justify-between px-4 py-2.5 bg-slate-50 dark:bg-[#07090e]/90 border-b border-slate-200 dark:border-white/20 gap-2">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded bg-white dark:bg-neutral-900 border border-slate-200 dark:border-white/30 flex items-center justify-center shadow-xs">
                  <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400 text-[18px]">layers</span>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-['Space_Grotesk'] text-[15px] text-slate-900 dark:text-white uppercase font-bold tracking-wide">TACTICAL MINE GIS &amp; GEOTECHNICAL SURVEILLANCE</span>
                    <span class="px-1.5 py-0.2 rounded text-[8px] bg-cyan-50 text-cyan-800 border border-cyan-300 dark:bg-cyan-500/20 dark:text-cyan-300 dark:border-cyan-500/40 font-bold">HIGH-RES GIS ENGINE</span>
                  </div>
                  <div class="flex flex-wrap items-center gap-2.5 font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-on-surface-variant">
                    <span id="map-cursor-coords" class="font-bold text-slate-700 dark:text-zinc-300">LAT: 23.79574° N | LNG: 86.43041° E | EL: 142m RL</span>
                    <span class="text-amber-700 dark:text-secondary font-semibold">| GRID: IN-JH-CHAS-4B</span>
                  </div>
                </div>
              </div>

              <!-- Tactical GIS Controls Toolbar -->
              <div class="flex flex-wrap items-center gap-2">
                <!-- Base Layer Switcher -->
                <div class="flex items-center bg-slate-100 dark:bg-[#07090e] border border-slate-200 dark:border-white/20 rounded-lg p-0.5 gap-0.5">
                  <button onclick="window.terraMapController && window.terraMapController.setLayer('satellite')" title="Esri High-Resolution Satellite" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-slate-700 dark:text-zinc-300 font-semibold">
                    🛰️ SATELLITE
                  </button>
                  <button onclick="window.terraMapController && window.terraMapController.setLayer('topo')" title="OpenTopoMap Elevation Contours" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-slate-700 dark:text-zinc-300 font-semibold">
                    🗺️ TOPO
                  </button>
                  <button onclick="window.terraMapController && window.terraMapController.setLayer('dark')" title="Tactical Dark Matter" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-slate-700 dark:text-zinc-300 font-semibold">
                    🌑 DARK
                  </button>
                  <button onclick="window.terraMapController && window.terraMapController.setLayer('light')" title="Engineering Blueprint Light" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-slate-700 dark:text-zinc-300 font-semibold">
                    ☀️ LIGHT
                  </button>
                </div>

                <!-- Focus Target Presets -->
                <div class="flex items-center bg-slate-100 dark:bg-[#07090e] border border-slate-200 dark:border-white/20 rounded-lg p-0.5 gap-0.5">
                  <button onclick="window.terraMapController && window.terraMapController.focusSector4B()" title="Focus Sector 4B Critical Pillar" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-rose-600 dark:text-rose-400 font-bold">
                    🎯 SEC-4B
                  </button>
                  <button onclick="window.terraMapController && window.terraMapController.focusShaft2()" title="Focus Shaft #2 Collar" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-cyan-600 dark:text-cyan-300 font-bold">
                    🏗️ SHAFT #2
                  </button>
                  <button onclick="window.terraMapController && window.terraMapController.focusSump()" title="Focus Sump Subsurface Basin" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-sky-600 dark:text-sky-300 font-bold">
                    🌊 SUMP
                  </button>
                  <button onclick="window.terraMapController && window.terraMapController.overview()" title="Full Colliery Overview" class="font-['JetBrains_Mono'] text-[10px] uppercase px-2 py-1 rounded transition cursor-pointer hover:bg-white dark:hover:bg-neutral-800 text-slate-700 dark:text-zinc-300 font-bold">
                    🌐 OVERVIEW
                  </button>
                </div>

                <!-- Emergency Dispatch Trigger -->
                <button ng-click="vm.openEvacModal()" class="bg-rose-600 hover:bg-rose-700 text-white font-['JetBrains_Mono'] text-[10px] uppercase font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition shadow-sm active:scale-95 cursor-pointer animate-pulse">
                  <span class="material-symbols-outlined text-[15px]">campaign</span> EVACUATE PROTOCOL
                </button>
              </div>
            </div>

            <!-- Tactical GIS Map Container -->
            <div id="map-canvas-container" class="relative w-full h-[540px] bg-[#07090e] overflow-hidden select-none transition-all duration-500">
              <!-- Leaflet Interactive Tactical Mine Map Container -->
              <div id="tactical-mine-map" tactical-map class="absolute inset-0 w-full h-full z-10"></div>

              <!-- DGMS Protocol Infused Tactical HUD Overlay -->
              <div class="absolute inset-0 pointer-events-none z-20">
                <!-- Top-Left Protocol Status Ribbon -->
                <div class="absolute top-3 left-3 pointer-events-auto flex flex-col gap-1.5">
                  <div class="map-overlay-box flex items-center gap-2 bg-white/95 dark:bg-[#07090e]/92 backdrop-blur-md border border-slate-200 dark:border-rose-500/60 px-3 py-1.5 rounded-lg shadow-md">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-600 animate-ping"></span>
                    <div class="flex flex-col">
                      <div class="flex items-center gap-2 font-['JetBrains_Mono'] text-[10px]">
                        <span class="text-rose-700 dark:text-rose-400 font-bold uppercase tracking-wider">DGMS REG-124 SAFETY PROTOCOL</span>
                        <span class="px-1.5 py-0.2 rounded bg-rose-100 dark:bg-rose-500/20 text-rose-800 dark:text-rose-300 font-bold text-[8px] border border-rose-200 dark:border-rose-500/40">LEVEL IV ACTIVE</span>
                      </div>
                      <span class="font-['Space_Grotesk'] text-slate-800 dark:text-white text-[11px] font-medium">
                        Evac Radius: 220m Critical • Incline Corridor Alpha &amp; Hoist Beta Armed
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Bottom-Right Infused Protocol GIS Legend -->
                <div class="map-overlay-box absolute bottom-3 right-3 pointer-events-none bg-white/95 dark:bg-[#07090e]/95 backdrop-blur-md p-2.5 rounded-lg border border-slate-200 dark:border-white/20 flex flex-col gap-1 shadow-md">
                  <span class="font-['JetBrains_Mono'] text-[9px] uppercase text-slate-700 dark:text-zinc-300 font-bold tracking-wider">DGMS INFUSED PROTOCOL LEGEND</span>
                  <div class="grid grid-cols-2 gap-x-3 gap-y-1 font-['JetBrains_Mono'] text-[9px]">
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full border border-rose-500 bg-rose-500/40"></span>
                      <span class="text-rose-700 dark:text-rose-300 font-semibold">220m Evacuation Ring</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full border border-amber-500 bg-amber-500/30"></span>
                      <span class="text-amber-700 dark:text-amber-300 font-semibold">450m Watch Buffer</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-3 h-0.5 bg-emerald-500"></span>
                      <span class="text-emerald-700 dark:text-emerald-300 font-semibold">Corridor Alpha (Surface)</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-3 h-0.5 bg-sky-500"></span>
                      <span class="text-sky-700 dark:text-cyan-300 font-semibold">Corridor Beta (Shaft #2)</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-3 h-0.5 bg-rose-600 border-b border-dashed"></span>
                      <span class="text-rose-700 dark:text-rose-400 font-semibold">Geological Fault F-4B</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-cyan-600"></span>
                      <span class="text-cyan-700 dark:text-cyan-300 font-semibold">REL-35 Sump Reservoir</span>
                    </div>
                    <div class="flex items-center gap-1.5 col-span-2">
                      <span class="w-2.5 h-2.5 rounded bg-slate-300 dark:bg-slate-700 border border-slate-400 dark:border-slate-500"></span>
                      <span class="text-slate-600 dark:text-zinc-400">Sector 4B Subterranean Stope Panel</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Node Selector strip -->
            <div id="node-selector-strip" class="grid grid-cols-5 gap-1 p-1 bg-slate-100 dark:bg-[#07090e] font-['JetBrains_Mono'] text-[11px] border-t border-slate-200 dark:border-white/20">
              <button ng-repeat="node in vm.nodes" ng-click="vm.selectNode(node.id)" class="flex flex-col items-center py-1.5 rounded-lg transition-all cursor-pointer" ng-class="vm.activeNode === node.id ? 'active-node-btn bg-slate-900 dark:bg-gradient-to-b dark:from-[#ff3366] dark:to-[#c30044] text-white shadow-sm border border-slate-900 dark:border-[#ff3366]' : 'bg-white dark:bg-[#0b0f19] border border-slate-200 dark:border-white/10 hover:border-slate-300 dark:hover:border-white/30 text-slate-800 dark:text-zinc-200'">
                <span class="font-bold text-[11px]" ng-class="vm.activeNode === node.id ? 'text-white' : node.statusClass">{{ node.name }}</span>
                <span class="text-[9px]" ng-class="vm.activeNode === node.id ? 'text-white/90' : 'text-slate-500 dark:text-zinc-400'">{{ node.status }} ({{ node.ping }})</span>
                <!-- Node Health Micro-badges -->
                <div class="flex items-center justify-center gap-2 mt-0.5">
                  <div class="node-health-bar" title="Battery {{ node.batPct }}%">
                    <span ng-class="vm.getBatBarClass(node.batPct)"></span>
                    <span ng-class="node.batPct >= 25 ? vm.getBatBarClass(node.batPct) : 'low'"></span>
                    <span ng-class="node.batPct >= 50 ? vm.getBatBarClass(node.batPct) : 'low'"></span>
                    <span ng-class="node.batPct >= 75 ? vm.getBatBarClass(node.batPct) : 'low'"></span>
                  </div>
                  <span class="font-['JetBrains_Mono'] text-[8px]" ng-class="vm.activeNode === node.id ? 'text-white/70' : 'text-slate-400 dark:text-zinc-500'" title="Packet Loss">{{ node.packetLoss }}%PL</span>
                </div>
              </button>
            </div>
