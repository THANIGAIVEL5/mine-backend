              <div class="bg-slate-50 dark:bg-[#07090e] border border-slate-200 dark:border-white/5 p-2 rounded flex flex-col">
                <span class="text-slate-500 dark:text-on-surface-variant text-[9px] uppercase">Selected Node Bat</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">84% (3.94V)</span>
                <span class="text-slate-500 dark:text-on-surface-variant text-[9px]">Li-ion 18650 3.7V</span>
              </div>
            </div>
          </div>

          <!-- GLOBAL INCIDENT COMMAND DISPATCH LOGS (5 COLS) -->
          <div class="hud-bracket xl:col-span-5 flex flex-col bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md rounded border border-slate-200 dark:border-white/20 p-4 shadow-sm dark:shadow-[0_4px_24px_rgba(0,0,0,0.6)] justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-white/20">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded bg-slate-100 dark:bg-neutral-900 border border-slate-200 dark:border-white/30 flex items-center justify-center">
                    <span class="material-symbols-outlined text-slate-700 dark:text-white text-[18px]">security_update_warning</span>
                  </div>
                  <span class="font-['Space_Grotesk'] text-[15px] text-slate-900 dark:text-white uppercase font-bold">Dispatch &amp; Alert Audit Feed</span>
                </div>
                <span class="font-['JetBrains_Mono'] text-emerald-600 dark:text-emerald-400 text-[11px] font-bold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>AUTO-BROADCAST ON
                </span>
              </div>

              <!-- Audit Timeline Entries -->
              <div id="incident-log-list" class="mt-2 flex flex-col gap-2">
                <!-- Log Entry 1: Critical Dispatch -->
                <div class="bg-rose-50/70 dark:bg-[#07090e] border border-rose-200 dark:border-[#ff3366]/30 p-2.5 rounded flex items-start gap-2.5">
                  <div class="w-6 h-6 rounded bg-rose-100 dark:bg-[#ff3366]/20 border border-rose-300 dark:border-[#ff3366]/40 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-rose-600 dark:text-[#ff3366] text-[15px]">sms</span>
                  </div>
                  <div class="flex flex-col flex-1 min-w-0">
                    <div class="flex items-center justify-between font-['JetBrains_Mono'] text-[10px]">
                      <span class="text-rose-700 dark:text-[#ff3366] font-bold">EMERGENCY SMS/EMAIL BROADCAST</span>
                      <span class="text-slate-500 dark:text-on-surface-variant">14:31:52 IST</span>
                    </div>
                    <p class="font-['Space_Grotesk'] text-[11px] text-slate-700 dark:text-on-surface truncate mt-0.5">
                      Dispatched to Mine Safety Officer (Er. R. Sharma): Evacuate Sub-Sector 4 Stope.
                    </p>
                  </div>
                </div>
                <!-- Log Entry 2: Rule Trigger -->
                <div class="bg-amber-50/70 dark:bg-[#07090e] border border-amber-200 dark:border-amber-500/30 p-2.5 rounded flex items-start gap-2.5">
                  <div class="w-6 h-6 rounded bg-amber-100 dark:bg-amber-500/20 border border-amber-300 dark:border-amber-500/40 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-amber-600 dark:text-amber-400 text-[15px]">rule</span>
                  </div>
                  <div class="flex flex-col flex-1 min-w-0">
                    <div class="flex items-center justify-between font-['JetBrains_Mono'] text-[10px]">
                      <span class="text-amber-700 dark:text-amber-400 font-bold">AUTO-INCIDENT LOGGED #4092</span>
                      <span class="text-slate-500 dark:text-on-surface-variant">14:30:11 IST</span>
                    </div>
                    <p class="font-['Space_Grotesk'] text-[11px] text-slate-700 dark:text-on-surface truncate mt-0.5">
                      Threshold Excursion: Tilt angular velocity 2.10°/hr exceeded standard 1.20°/hr.
                    </p>
                  </div>
                </div>
                <!-- Log Entry 3: Siren Activation -->
                <div class="bg-slate-50 dark:bg-[#07090e] border border-slate-200 dark:border-white/20 p-2.5 rounded flex items-start gap-2.5">
                  <div class="w-6 h-6 rounded bg-slate-200 dark:bg-neutral-900 border border-slate-300 dark:border-white/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-slate-700 dark:text-white text-[15px]">volume_up</span>
                  </div>
                  <div class="flex flex-col flex-1 min-w-0">
                    <div class="flex items-center justify-between font-['JetBrains_Mono'] text-[10px]">
                      <span class="text-slate-800 dark:text-white font-bold">SURFACE KLAXON TRIGGER</span>
                      <span class="text-slate-500 dark:text-on-surface-variant">14:28:40 IST</span>
                    </div>
                    <p class="font-['Space_Grotesk'] text-[11px] text-slate-700 dark:text-on-surface truncate mt-0.5">
                      Pillar 4B acoustic beacon triggered at 110dB (Zone SEC-4 Gate).
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Dispatch Controls -->
            <div class="flex items-center gap-2 mt-3">
              <button onclick="alert('AUDIT LOG RE-DISPATCHED to DGMS central monitoring server.');" class="flex-1 bg-slate-100 hover:bg-slate-200 dark:bg-neutral-900 dark:hover:bg-neutral-800 border border-slate-300 dark:border-white/30 text-slate-800 dark:text-white font-['JetBrains_Mono'] text-[11px] py-2 rounded uppercase font-bold flex items-center justify-center gap-1.5 transition-all shadow-sm">
                <span class="material-symbols-outlined text-[14px]">send</span> RE-DISPATCH AUDIT LOG
              </button>
              <button ng-click="vm.openAuditModal()" class="bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-neutral-200 dark:text-black font-['JetBrains_Mono'] text-[11px] px-4 py-2 rounded uppercase font-bold transition-all shadow-sm">
                EXPORT DGMS REPORT (PDF)
              </button>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>

  <!-- DGMS Emergency Evacuation Dispatch Angular Component -->
  <evacuation-modal is-open="vm.isEvacModalOpen" telemetry="vm.telemetry" on-close="vm.closeEvacModal()" on-confirm="vm.confirmEvacDispatch()"></evacuation-modal>

  <!-- Command Palette (Ctrl+K) -->
  <div ng-controller="CommandPaletteController as cp">
    <div ng-if="cp.isOpen" class="cmd-palette-backdrop" ng-click="$event.target === $event.currentTarget && cp.close()">
      <div class="cmd-palette-modal">
        <div class="flex items-center gap-3 px-4 border-b border-white/10 dark:border-white/10">
          <span class="material-symbols-outlined text-slate-400 dark:text-zinc-400 text-[18px]">search</span>
          <input id="cmd-palette-input" type="text" class="cmd-palette-input" ng-model="cp.query" ng-change="cp.filterCommands()" placeholder="Search commands... (↑↓ to navigate, Enter to run, Esc to close)" autocomplete="off" />
          <kbd class="text-slate-500 dark:text-zinc-500 font-['JetBrains_Mono'] text-[10px] border border-white/10 px-1.5 py-0.5 rounded">ESC</kbd>
        </div>
        <div class="py-2 max-h-[55vh] overflow-y-auto">
          <div ng-if="cp.filtered.length === 0" class="px-6 py-8 text-center font-['JetBrains_Mono'] text-[12px] text-slate-500 dark:text-zinc-500">
            No commands match "{{ cp.query }}"
          </div>
          <div ng-repeat="cmd in cp.filtered track by $index" class="cmd-palette-item" ng-class="$index === cp.activeIndex ? 'active' : ''" ng-click="cp.execute(cmd)">
            <div class="w-7 h-7 rounded-lg flex items-center justify-center bg-white/5 dark:bg-white/5 flex-shrink-0">
              <span class="material-symbols-outlined text-[16px]" ng-class="cp.getCategoryColor(cmd.category)">{{ cmd.icon }}</span>
            </div>
            <div class="flex-1 min-w-0">
              <span class="font-['Space_Grotesk'] text-[13px] font-semibold text-slate-900 dark:text-white block">{{ cmd.label }}</span>
            </div>
            <span class="font-['JetBrains_Mono'] text-[9px] font-bold uppercase px-2 py-0.5 rounded-full border" ng-class="cp.getCategoryColor(cmd.category)" style="border-color: currentColor; opacity: 0.7;">{{ cmd.category }}</span>
          </div>
        </div>
        <div class="px-4 py-2 border-t border-white/8 dark:border-white/8 flex items-center gap-3 font-['JetBrains_Mono'] text-[9px] text-slate-500 dark:text-zinc-500">
          <span><kbd class="bg-white/10 px-1.5 py-0.5 rounded text-white/60">↑↓</kbd> navigate</span>
          <span><kbd class="bg-white/10 px-1.5 py-0.5 rounded text-white/60">↵</kbd> execute</span>
          <span><kbd class="bg-white/10 px-1.5 py-0.5 rounded text-white/60">Ctrl+K</kbd> toggle</span>
          <span class="ml-auto">{{ cp.filtered.length }} commands</span>
        </div>
      </div>
    </div>
  </div>

  <!-- DGMS Statutory Audit Report Modal -->
  <div ng-if="vm.isAuditModalOpen" class="audit-modal-backdrop" ng-click="$event.target === $event.currentTarget && vm.closeAuditModal()">
    <div class="audit-modal">
      <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-amber-400 text-[22px]">description</span>
          <div>
            <div class="font-['Space_Grotesk'] text-[16px] font-bold text-slate-900 dark:text-white">DGMS STATUTORY AUDIT REPORT</div>
            <div class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-zinc-400 uppercase">Form IV • Chasnala Deep Mine • Sector 4B • {{ vm.auditTimestamp }}</div>
          </div>
        </div>
        <button ng-click="vm.closeAuditModal()" class="text-slate-400 hover:text-white transition cursor-pointer"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 py-4 space-y-4">
        <!-- Node Status Table -->
        <div>
          <div class="font-['JetBrains_Mono'] text-[10px] uppercase font-bold text-slate-500 dark:text-zinc-400 mb-2">SENSOR NODE STATUS MATRIX</div>
          <table class="w-full text-[11px] font-['JetBrains_Mono'] border border-slate-200 dark:border-white/10 rounded-lg overflow-hidden">
            <thead>
              <tr class="bg-slate-100 dark:bg-white/5">
                <th class="text-left px-3 py-2 text-slate-600 dark:text-zinc-300">NODE</th>
                <th class="text-left px-3 py-2 text-slate-600 dark:text-zinc-300">LOCATION</th>
                <th class="text-left px-3 py-2 text-slate-600 dark:text-zinc-300">STATUS</th>
                <th class="text-left px-3 py-2 text-slate-600 dark:text-zinc-300">BATTERY</th>
                <th class="text-left px-3 py-2 text-slate-600 dark:text-zinc-300">PKT LOSS</th>
              </tr>
            </thead>
            <tbody>
              <tr ng-repeat="node in vm.nodes" class="border-t border-slate-100 dark:border-white/5">
                <td class="px-3 py-1.5 font-bold" ng-class="node.statusClass">{{ node.name }}</td>
                <td class="px-3 py-1.5 text-slate-700 dark:text-zinc-300">{{ node.location }}</td>
                <td class="px-3 py-1.5">
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-bold" ng-class="node.status === 'CRITICAL' ? 'bg-rose-100 text-rose-800 dark:bg-rose-500/20 dark:text-rose-400' : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400'">{{ node.status }}</span>
                </td>
                <td class="px-3 py-1.5 text-slate-700 dark:text-zinc-300">{{ node.battery }}V ({{ node.batPct }}%)</td>
                <td class="px-3 py-1.5" ng-class="node.packetLoss > 1 ? 'text-rose-600 dark:text-rose-400 font-bold' : 'text-slate-600 dark:text-zinc-400'">{{ node.packetLoss }}%</td>
              </tr>
            </tbody>
          </table>
        </div>
        <!-- Active Sensor Readings -->
        <div>
          <div class="font-['JetBrains_Mono'] text-[10px] uppercase font-bold text-slate-500 dark:text-zinc-400 mb-2">ACTIVE CRITICAL SENSOR READINGS</div>
          <div class="grid grid-cols-3 gap-2">
            <div class="bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 p-2.5 rounded-lg">
              <div class="font-['JetBrains_Mono'] text-[9px] text-rose-700 dark:text-rose-400 uppercase">Tilt (Pitch)</div>
              <div class="font-['JetBrains_Mono'] text-[22px] font-black text-rose-700 dark:text-rose-400">{{ vm.telemetry.pitch | number:2 }}°</div>
            </div>
            <div class="bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 p-2.5 rounded-lg">
              <div class="font-['JetBrains_Mono'] text-[9px] text-rose-700 dark:text-rose-400 uppercase">Vibration RMS</div>
              <div class="font-['JetBrains_Mono'] text-[22px] font-black text-rose-700 dark:text-rose-400">{{ vm.telemetry.rms | number:3 }}g</div>
            </div>
            <div class="bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/30 p-2.5 rounded-lg">
              <div class="font-['JetBrains_Mono'] text-[9px] text-amber-700 dark:text-amber-400 uppercase">CO Level</div>
              <div class="font-['JetBrains_Mono'] text-[22px] font-black text-amber-700 dark:text-amber-400">{{ vm.telemetry.co | number:1 }} ppm</div>
            </div>
          </div>
        </div>
        <!-- Personnel -->
        <div>
          <div class="font-['JetBrains_Mono'] text-[10px] uppercase font-bold text-slate-500 dark:text-zinc-400 mb-2">PERSONNEL UNDERGROUND AT TIME OF REPORT</div>
          <div class="font-['JetBrains_Mono'] text-[24px] font-black text-slate-900 dark:text-white">{{ vm.totalMiners }} MINERS</div>
          <div class="font-['Space_Grotesk'] text-[12px] text-rose-600 dark:text-rose-400 font-semibold">8 in Critical Zone SEC-4B — Mandatory evacuation recommended</div>
        </div>
        <!-- Officer Sign-off -->
        <div class="border-t border-slate-200 dark:border-white/10 pt-4">
          <div class="font-['JetBrains_Mono'] text-[10px] uppercase font-bold text-slate-500 dark:text-zinc-400 mb-3">OFFICER CHAIN-OF-CUSTODY SIGN-OFF</div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-zinc-400 uppercase block mb-1">Mine Manager / Safety Officer Name</label>
              <input type="text" ng-model="vm.officerName" placeholder="Er. R. Sharma" class="w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/20 rounded-lg px-3 py-2 font-['JetBrains_Mono'] text-[12px] text-slate-900 dark:text-white focus:outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-zinc-400 uppercase block mb-1">DGMS Badge / Employee ID</label>
              <input type="text" ng-model="vm.officerBadge" placeholder="DGMS-JH-2024-0042" class="w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/20 rounded-lg px-3 py-2 font-['JetBrains_Mono'] text-[12px] text-slate-900 dark:text-white focus:outline-none focus:border-sky-500" />
            </div>
          </div>
          <div class="mt-3">
            <label class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-zinc-400 uppercase block mb-1">Mitigation Action Taken</label>
            <textarea ng-model="vm.officerAction" placeholder="e.g. Dispatched roof bolting crew to Pillar 4B. Initiated Stage III evacuation. Notified DGMS Dhanbad HQ." rows="2" class="w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/20 rounded-lg px-3 py-2 font-['Space_Grotesk'] text-[12px] text-slate-900 dark:text-white focus:outline-none focus:border-sky-500 resize-none"></textarea>
          </div>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-slate-200 dark:border-white/10 flex items-center gap-3">
        <button ng-click="vm.closeAuditModal()" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-white/20 text-slate-600 dark:text-zinc-400 font-['JetBrains_Mono'] text-[11px] uppercase font-bold hover:bg-slate-50 dark:hover:bg-white/5 transition cursor-pointer">Cancel</button>
        <button ng-click="vm.printAuditReport()" ng-disabled="!vm.officerName" class="flex-1 py-2 rounded-lg font-['JetBrains_Mono'] text-[11px] uppercase font-bold flex items-center justify-center gap-2 transition cursor-pointer" ng-class="vm.officerName ? 'bg-slate-900 hover:bg-black dark:bg-white dark:hover:bg-zinc-200 text-white dark:text-black shadow-md' : 'bg-slate-200 dark:bg-white/10 text-slate-400 cursor-not-allowed'">
          <span class="material-symbols-outlined text-[15px]">print</span> GENERATE & PRINT DGMS REPORT
        </button>
      </div>
    </div>
  </div>

  <!-- Hidden DGMS Print Template -->
  <div id="dgms-print-report" style="display:none;">
    <h1>DIRECTORATE GENERAL OF MINES SAFETY — FORM IV STATUTORY AUDIT REPORT</h1>
    <p><strong>Mine:</strong> Chasnala Deep Mine, Jharkhand | <strong>Sector:</strong> 4B | <strong>Time:</strong> {{ vm.auditTimestamp }}</p>
    <h2>1. Sensor Node Status</h2>
    <table>
      <tr><th>Node</th><th>Location</th><th>Status</th><th>Battery</th><th>Pkt Loss</th></tr>
      <tr ng-repeat="node in vm.nodes"><td>{{ node.name }}</td><td>{{ node.location }}</td><td>{{ node.status }}</td><td>{{ node.battery }}V</td><td>{{ node.packetLoss }}%</td></tr>
    </table>
    <h2>2. Critical Sensor Readings</h2>
    <table>
      <tr><th>Parameter</th><th>Value</th><th>Threshold</th><th>Status</th></tr>
      <tr><td>Tilt (Pitch)</td><td>{{ vm.telemetry.pitch | number:2 }}°</td><td>3.0°</td><td>EXCEEDED</td></tr>
      <tr><td>Vibration RMS</td><td>{{ vm.telemetry.rms | number:3 }} g</td><td>0.25g</td><td>EXCEEDED</td></tr>
      <tr><td>CO Gas</td><td>{{ vm.telemetry.co | number:1 }} ppm</td><td>15 ppm</td><td>EXCEEDED</td></tr>
      <tr><td>Sump Level</td><td>{{ vm.telemetry.sump | number:1 }}%</td><td>85%</td><td>WATCH</td></tr>
    </table>
    <h2>3. Personnel Underground</h2>
    <p><strong>Total:</strong> {{ vm.totalMiners }} miners | <strong>Critical Zone SEC-4B:</strong> 8 miners</p>
    <h2>4. Officer Sign-Off</h2>
    <p><strong>Name:</strong> {{ vm.officerName || '___________________' }} | <strong>Badge:</strong> {{ vm.officerBadge || '___________________' }}</p>
    <p><strong>Action Taken:</strong> {{ vm.officerAction || '___________________________________________________________________________________________' }}</p>
    <div class="sign-box">
      <div><div class="sign-line"></div><p>Mine Manager Signature</p></div>
      <div><div class="sign-line"></div><p>Safety Officer Signature</p></div>
      <div><div class="sign-line"></div><p>DGMS Inspector Signature</p></div>
    </div>
  </div>

  <!-- Floating Cyber HUD AI Chat Assistant Widget -->
  <%- include('partials/chat-widget') %>
</body>
</html>
