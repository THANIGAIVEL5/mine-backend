          </div>

          <!-- GLOBAL INCIDENT COMMAND DISPATCH LOGS (5 COLS) -->
          <div class="hud-bracket xl:col-span-5 flex flex-col bg-[#0b0f19]/90 backdrop-blur-md rounded border border-cyan-500/20 p-4 shadow-[0_4px_24px_rgba(0,0,0,0.6)] justify-between">
            <div>
              <div class="flex items-center justify-between pb-2 border-b border-cyan-500/20">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded bg-cyan-950/60 border border-cyan-400/30 flex items-center justify-center">
                    <span class="material-symbols-outlined text-cyan-400 text-[18px]">security_update_warning</span>
                  </div>
                  <span class="font-['Space_Grotesk'] text-[15px] text-white uppercase font-bold">Dispatch &amp; Alert Audit Feed</span>
                </div>
                <span class="font-['JetBrains_Mono'] text-emerald-400 text-[11px] font-bold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>AUTO-BROADCAST ON
                </span>
              </div>

              <!-- Audit Timeline Entries -->
              <div class="mt-2 flex flex-col gap-2">
                <!-- Log Entry 1: Critical Dispatch -->
                <div class="bg-[#07090e] border border-[#ff3366]/30 p-2.5 rounded flex items-start gap-2.5">
                  <div class="w-6 h-6 rounded bg-[#ff3366]/20 border border-[#ff3366]/40 flex items-center justify-center flex-shrink-0 mt-0.5">
