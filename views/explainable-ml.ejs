<!DOCTYPE html>
<html class="light" lang="en" ng-app="terraPulseApp">
<head>
  <%- include('partials/head', { title: 'TERRA-PULSE OS - Explainable ML & Subsidence Risk | SIH 2026' }) %>
</head>
<body ng-controller="ExplainableMlController as vm" ng-cloak class="bg-slate-50 dark:bg-[#07090e] font-['Space_Grotesk'] text-[13px] text-slate-800 dark:text-white antialiased selection:bg-cyan-400 selection:text-black min-h-screen relative overflow-x-hidden">
  <!-- Ambient Glow Gradients -->
  <div class="fixed inset-0 pointer-events-none bg-[radial-gradient(circle_at_25%_15%,rgba(2,132,199,0.04),transparent_45%),radial-gradient(circle_at_80%_25%,rgba(225,29,72,0.03),transparent_40%),radial-gradient(circle_at_50%_75%,rgba(241,245,249,0.8),transparent_50%)] dark:bg-[radial-gradient(circle_at_25%_15%,rgba(0,245,255,0.04),transparent_45%),radial-gradient(circle_at_80%_25%,rgba(239,68,68,0.05),transparent_40%),radial-gradient(circle_at_50%_75%,rgba(255,255,255,0.02),transparent_50%)] z-0"></div>

  <!-- Tactical Sidebar -->
  <%- include('partials/sidebar', { activePage: 'ml' }) %>

  <!-- Main Content Wrapper with Top Margin for Fixed Header -->
  <div class="pl-64 relative z-10 min-h-screen flex flex-col">
    <!-- Top HUD Header -->
    <%- include('partials/header', { systemMode: 'SYSTEM MODE: XAI TREE-SHAP & DGMS PROTOCOL', targetGeometry: 'TARGET GEOMETRY: DRIFT & SHAFT 12' }) %>

    <!-- Main Container -->
    <main class="relative pt-24 w-full px-6 pb-16 space-y-5 max-w-[1680px] mx-auto bg-slate-50 dark:bg-[#07090e]">
      
      <!-- 1. Top Telemetry Status Rail -->
      <div class="flex flex-wrap items-center justify-between gap-4 bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md border border-slate-200 dark:border-white/20 px-4 py-3 rounded-lg shadow-sm">
        <div class="flex flex-wrap items-center gap-3">
          <span class="font-['JetBrains_Mono'] text-xs uppercase tracking-widest text-sky-700 dark:text-cyan-400 font-bold px-2.5 py-1 bg-sky-50 dark:bg-cyan-500/10 rounded border border-sky-200 dark:border-cyan-500/30 flex items-center gap-1.5 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-sky-600 dark:bg-cyan-400 animate-pulse"></span> MASTER AI ACTIVE
          </span>
          <span class="font-['JetBrains_Mono'] text-xs text-slate-800 dark:text-zinc-300 font-semibold">TERRA-SENTINEL CENTRAL CONTROLLER</span>
          <span class="text-slate-300 dark:text-zinc-600">/</span>
          <span class="font-['JetBrains_Mono'] text-xs text-sky-700 dark:text-cyan-300 font-bold">XAI TREE-SHAP EXPLAINABILITY</span>
          <span class="text-slate-300 dark:text-zinc-600">/</span>
          <span class="font-['JetBrains_Mono'] text-xs text-amber-700 dark:text-amber-400 font-semibold">DGMS 1957/2017 SAFETY CORE</span>
        </div>
        <div class="flex flex-wrap items-center gap-5 font-['JetBrains_Mono'] text-xs">
          <div><span class="text-slate-500 dark:text-zinc-400 uppercase text-[10px] mr-1.5 font-semibold">LATENCY:</span><span class="text-sky-700 dark:text-cyan-400 font-bold">{{ vm.latency }}</span></div>
          <div><span class="text-slate-500 dark:text-zinc-400 uppercase text-[10px] mr-1.5 font-semibold">CYCLE:</span><span class="text-slate-900 dark:text-white font-bold">3600s</span></div>
          <div><span class="text-slate-500 dark:text-zinc-400 uppercase text-[10px] mr-1.5 font-semibold">BAYES CONF:</span><span class="text-emerald-700 dark:text-emerald-400 font-bold">{{ vm.bayesConf }}</span></div>
          <div><span class="text-slate-500 dark:text-zinc-400 uppercase text-[10px] mr-1.5 font-semibold">DGMS PROTOCOL:</span><span class="text-rose-700 dark:text-rose-400 font-bold px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40">STAGE-III ALERT</span></div>
        </div>
      </div>

      <!-- 2. Master AI Geotechnical Directive Ticker -->
      <div class="bg-white dark:bg-[#05080c] border border-sky-200 dark:border-cyan-500/30 rounded-lg px-4 py-2.5 flex items-center justify-between gap-3 font-['JetBrains_Mono'] text-xs shadow-xs">
        <div class="flex items-center gap-2.5 overflow-hidden flex-1">
          <span class="px-2 py-0.5 rounded bg-sky-50 dark:bg-neutral-900 border border-sky-300 dark:border-cyan-500/40 text-sky-800 dark:text-cyan-400 text-[10px] font-bold uppercase shrink-0 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-600 dark:bg-cyan-400 animate-ping"></span> MASTER AI DIRECTIVE
          </span>
          <span class="text-slate-800 dark:text-zinc-100 truncate font-sans text-xs tracking-wide font-medium">
            {{ vm.aiInsightDisplay }}
          </span>
        </div>
        <a href="/" onclick="if(location.protocol==='file:' || location.pathname.indexOf('.html')!==-1){location.href='index.html'; return false;}" class="shrink-0 text-sky-600 dark:text-cyan-400 hover:text-sky-800 dark:hover:text-white text-[11px] underline flex items-center gap-1 transition-colors font-bold cursor-pointer">
          <span>Live HUD</span> <span class="material-symbols-outlined text-xs">open_in_new</span>
        </a>
      </div>

      <!-- 3. Critical Subsidence Hazard Alert Banner -->
      <div class="relative overflow-hidden bg-rose-50 dark:bg-gradient-to-r dark:from-rose-950/40 dark:via-[#0b0f19] dark:to-[#0b0f19] border border-rose-200 dark:border-rose-500/50 rounded-xl p-4.5 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-xs">
        <div class="flex items-start md:items-center gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-rose-100 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/50 flex items-center justify-center shrink-0 shadow-xs">
            <span class="material-symbols-outlined text-rose-600 dark:text-rose-400 text-[24px] animate-pulse">crisis_alert</span>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-['JetBrains_Mono'] text-xs font-extrabold text-rose-700 dark:text-rose-400 tracking-wider uppercase">
                {{ ml.t('ELEVATED SUBSIDENCE WINDOW FORECAST', 'उन्नत अवतलन खिड़की पूर्वानुमान') }}
              </span>
              <span class="text-slate-300 dark:text-zinc-600">•</span>
              <span class="font-['JetBrains_Mono'] text-xs font-bold text-sky-700 dark:text-cyan-300 tracking-wide uppercase bg-white dark:bg-neutral-900 px-2.5 py-0.5 rounded border border-slate-200 dark:border-white/10 shadow-2xs">
                {{ ml.t('T+4.5 HRS TO TENSILE FAILURE THRESHOLD', 'T+4.5 घंटे तक तन्य विफलता सीमा') }}
              </span>
              <!-- Language Toggle -->
              <div class="lang-toggle ml-2">
                <button ng-click="ml.toggleLang()" ng-class="ml.lang === 'en' ? 'active' : ''">EN</button>
                <button ng-click="ml.toggleLang()" ng-class="ml.lang === 'hi' ? 'active' : ''">हिं</button>
              </div>
            </div>
            <p class="text-xs text-slate-600 dark:text-zinc-300 mt-1 leading-relaxed font-sans font-medium">
              {{ ml.t(
                'Chasnala Deep Mine • Sector 4B Shaft 12 • Strata delamination velocity accelerated at Pillar 4B Gallery. MPU6050 tilt gradient crossed 2.8°/hr dynamic limit.',
                'चासनाला गहरी खान • क्षेत्र 4B शाफ्ट 12 • स्तर विलगाव वेग पिलर 4B गैलरी में बढ़ा। MPU6050 झुकाव ढाल 2.8°/hr सीमा पार।'
              ) }}
            </p>
          </div>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          <button class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-['JetBrains_Mono'] text-xs uppercase font-extrabold tracking-wider rounded-lg transition-all flex items-center gap-2 shadow-md hover:shadow-lg cursor-pointer active:scale-95" ng-click="ml.openEvacModal()">
            <span class="material-symbols-outlined text-[17px]">campaign</span> {{ ml.t('EVACUATION PROTOCOL', 'निकासी प्रोटोकॉल') }}
          </button>
        </div>
      </div>
</div>

      <!-- 4. PRIMARY SECTION: 2-COL BENTO GRID (Strata Cross-Section & LSTM Trajectory) -->
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-5">
        <!-- Left: Geometric Deformation Projection (7 cols) -->
        <div class="xl:col-span-7 bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md border border-slate-200 dark:border-white/20 rounded-xl p-5 relative flex flex-col justify-between shadow-sm">
          <div>
            <!-- Header & Projection Mode Tabs -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <div>
                <span class="font-['JetBrains_Mono'] text-[10px] tracking-widest text-sky-700 dark:text-cyan-400 uppercase font-bold block mb-0.5">GEOMETRIC DEFORMATION PROJECTION</span>
                <h3 class="font-['Space_Grotesk'] text-base font-bold text-slate-900 dark:text-white">{{ vm.getProjectionTitle() }}</h3>
              </div>
              <div class="flex items-center gap-1 bg-slate-100 dark:bg-[#05080c] p-1 rounded-lg border border-slate-200 dark:border-white/10 font-['JetBrains_Mono'] text-[11px]">
                <button ng-click="vm.selectTab('insar')" class="px-2.5 py-1 transition-all rounded cursor-pointer" ng-class="vm.activeTab === 'insar' ? 'text-sky-700 dark:text-cyan-400 bg-white dark:bg-neutral-800 font-bold border border-slate-200 dark:border-cyan-500/40 shadow-xs' : 'text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white'">InSAR/GNSS</button>
                <button ng-click="vm.selectTab('strain')" class="px-2.5 py-1 transition-all rounded cursor-pointer" ng-class="vm.activeTab === 'strain' ? 'text-sky-700 dark:text-cyan-400 bg-white dark:bg-neutral-800 font-bold border border-slate-200 dark:border-cyan-500/40 shadow-xs' : 'text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white'">STRAIN-4B</button>
                <button ng-click="vm.selectTab('hydro')" class="px-2.5 py-1 transition-all rounded cursor-pointer" ng-class="vm.activeTab === 'hydro' ? 'text-sky-700 dark:text-cyan-400 bg-white dark:bg-neutral-800 font-bold border border-slate-200 dark:border-cyan-500/40 shadow-xs' : 'text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white'">HYDRO-SUMP</button>
                <button ng-click="vm.selectTab('seismic')" class="px-2.5 py-1 transition-all rounded cursor-pointer" ng-class="vm.activeTab === 'seismic' ? 'text-sky-700 dark:text-cyan-400 bg-white dark:bg-neutral-800 font-bold border border-slate-200 dark:border-cyan-500/40 shadow-xs' : 'text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white'">SEISMIC FFT</button>
              </div>
            </div>
            
            <!-- Isometric SVG Strata Cross-Section -->
            <div class="relative w-full h-72 bg-slate-50 dark:bg-[#05080c] rounded-lg border border-slate-200 dark:border-white/10 overflow-hidden">
              <svg class="w-full h-full" fill="none" viewbox="0 0 760 288" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <pattern height="24" id="grid-pattern-ml" patternunits="userSpaceOnUse" width="24">
                    <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(15,23,42,0.06)" stroke-width="1"></path>
                  </pattern>
                  <lineargradient id="delaminationGradMl" x1="0%" x2="100%" y1="0%" y2="100%">
                    <stop offset="0%" stop-color="#0284c7" stop-opacity="0.25"></stop>
                    <stop offset="50%" stop-color="#e11d48" stop-opacity="0.6"></stop>
                    <stop offset="100%" stop-color="#be123c" stop-opacity="0.9"></stop>
                  </lineargradient>
                </defs>
                
                <rect fill="url(#grid-pattern-ml)" height="100%" width="100%"></rect>
                
                <!-- Strata Plane 1: Surface / Overburden (0m to -120m) -->
                <polygon fill="#101724" points="90,45 640,45 720,85 170,85" stroke="#1e293b" stroke-width="1.5"></polygon>
                
                <!-- Strata Plane 2: Intermediate Sandstone (-120m to -220m) -->
                <polygon fill="#151e2e" points="70,105 620,105 700,145 150,145" stroke="#1e293b" stroke-dasharray="4 3" stroke-width="1.2"></polygon>
                
                <!-- Strata Plane 3: Coal Seam V / Mining Gallery (-280m) -->
                <polygon fill="#0d1420" points="50,165 600,165 680,215 130,215" stroke="#1e293b" stroke-width="1.5"></polygon>
                
                <!-- Flexure Depressed Curvature Mesh Lines -->
                <path d="M 170,85 Q 405,125 540,85" fill="none" stroke="#0284c7" stroke-dasharray="4 2" stroke-width="2"></path>
                <path d="M 150,145 Q 395,200 520,145" fill="none" stroke="#b45309" stroke-width="2"></path>
                <path d="M 130,215 Q 375,268 495,215" fill="none" stroke="#be123c" stroke-width="2.5"></path>
                
                <!-- Critical Delamination Void Polygon (Reacts to live pitch & what-if sliders) -->
                <polygon id="delam-polygon" class="transition-all duration-500" ng-attr-transform="{{ vm.getDelaminationTransform() }}" fill="url(#delaminationGradMl)" points="310,185 450,180 435,245 295,240" stroke="#be123c" stroke-width="2"></polygon>
                
                <!-- Depth Markers on Left Axis -->
                <g class="font-mono text-[9px]" fill="#475569">
                  <line stroke="#cbd5e1" stroke-width="1" x1="28" x2="28" y1="45" y2="215"></line>
                  <text x="35" y="48">0m (SURFACE)</text>
                  <text x="35" y="108">-120m (OVERBURDEN)</text>
                  <text fill="#b45309" x="35" y="185">-280m (SEAM V DRIFT)</text>
                </g>
                
                <!-- Sensor Nodes Placed in Isometric Space -->
                <g transform="translate(195, 78)">
                  <circle cx="0" cy="0" fill="#0284c7" r="4.5"></circle>
                  <circle cx="0" cy="0" opacity="0.6" r="9" stroke="#0284c7" stroke-width="1"></circle>
                  <line stroke="#0284c7" stroke-width="1" x1="0" x2="-25" y1="0" y2="-22"></line>
                  <text class="font-mono text-[9px] font-bold" fill="#0284c7" x="-95" y="-26">NODE-01 [STABLE: 0.12]</text>
                </g>
                
                <g transform="translate(585, 65)">
                  <circle cx="0" cy="0" fill="#0284c7" r="4.5"></circle>
                  <circle cx="0" cy="0" opacity="0.6" r="8" stroke="#0284c7" stroke-width="1"></circle>
                  <text class="font-mono text-[9px] font-semibold" fill="#334155" x="14" y="4">NODE-04 [NEO-6M: 0.08]</text>
                </g>
                
                <g transform="translate(285, 155)">
                  <circle cx="0" cy="0" fill="#b45309" r="5"></circle>
                  <circle cx="0" cy="0" r="11" stroke="#b45309" stroke-dasharray="2 2" stroke-width="1"></circle>
                  <text class="font-mono text-[9px] font-bold" fill="#b45309" x="-105" y="14">NODE-02 [WATCH: 0.62]</text>
                </g>
                
                <g transform="translate(385, 218)">
                  <circle cx="0" cy="0" fill="#be123c" r="7">
                    <animate attributename="r" dur="1.8s" repeatcount="indefinite" values="7;10;7"></animate>
                  </circle>
                  <circle cx="0" cy="0" r="18" stroke="#be123c" stroke-dasharray="3 2" stroke-width="1.5">
                    <animate attributename="stroke-opacity" dur="1.8s" repeatcount="indefinite" values="1;0.2;1"></animate>
                  </circle>
                  <line stroke="#be123c" stroke-width="1.5" x1="0" x2="0" y1="-10" y2="-24"></line>
                  <line stroke="#be123c" stroke-width="1.5" x1="0" x2="0" y1="10" y2="24"></line>
                  <text class="font-mono text-[10px] font-bold" fill="#be123c" x="24" y="2">NODE-03 (PILLAR 4B)</text>
                  <text class="font-mono text-[9px] font-bold" fill="#be123c" x="24" y="14">CRITICAL STRAIN (0.89)</text>
                  <text class="font-mono text-[8.5px] font-semibold" fill="#334155" x="24" y="26">dθ/dt: {{ vm.telemetry.pitch | number:2 }}°/hr | {{ vm.telemetry.disp | number:1 }}mm DELAM</text>
                </g>
                
                <g transform="translate(635, 185)">
                  <circle cx="0" cy="0" fill="#64748b" opacity="0.4" r="4"></circle>
                  <circle cx="0" cy="0" opacity="0.4" r="8" stroke="#64748b" stroke-dasharray="2 2" stroke-width="1"></circle>
                  <text class="font-mono text-[9px]" fill="#64748b" x="-80" y="-10">NODE-05 [OFFLINE]</text>
                </g>
              </svg>
              
              <!-- Inset Telemetry Overlays -->
              <div class="absolute bottom-3 left-3 bg-white/95 dark:bg-[#080c14]/90 backdrop-blur border border-slate-200 dark:border-white/20 px-3 py-1.5 rounded shadow-xs">
                <span class="font-mono text-[9px] text-slate-500 dark:text-zinc-400 tracking-widest uppercase block font-semibold">ZONE MAX FLEXURE</span>
                <span class="font-mono text-xl font-bold text-rose-600 dark:text-rose-400"><span>{{ vm.getZoneMaxFlexure() }}</span><span class="text-xs text-slate-500 dark:text-zinc-400 ml-1 font-normal">mm</span></span>
              </div>
              <div class="absolute top-3 right-3 bg-white/95 dark:bg-[#080c14]/90 backdrop-blur border border-slate-200 dark:border-white/20 px-3 py-1.5 rounded text-right shadow-xs">
                <span class="font-mono text-[9px] text-slate-500 dark:text-zinc-400 uppercase tracking-wider block font-semibold">SIMULATED CRITICAL VOID</span>
                <span class="font-mono text-xs font-bold text-sky-700 dark:text-cyan-400">142.6 m³ DELAMINATION</span>
              </div>
            </div>
          </div>

          <!-- Bottom Metric Bar -->
          <div class="grid grid-cols-3 gap-3 mt-4 pt-3 border-t border-slate-200 dark:border-white/10 font-['JetBrains_Mono']">
            <div class="bg-slate-50 dark:bg-[#05080c] p-2.5 rounded border border-slate-200 dark:border-white/10">
              <span class="text-[10px] text-slate-500 dark:text-zinc-400 uppercase block font-semibold">FAULT DIP ANGLE</span>
              <span class="text-sm font-bold text-sky-700 dark:text-cyan-400">64.3° SW</span>
            </div>
            <div class="bg-slate-50 dark:bg-[#05080c] p-2.5 rounded border border-slate-200 dark:border-white/10">
              <span class="text-[10px] text-slate-500 dark:text-zinc-400 uppercase block font-semibold">PORE WATER PRESS.</span>
              <span class="text-sm font-bold text-amber-700 dark:text-amber-400">2.41 MPa <span class="text-xs text-rose-600 dark:text-rose-400 font-normal">(+18%)</span></span>
            </div>
            <div class="bg-slate-50 dark:bg-[#05080c] p-2.5 rounded border border-slate-200 dark:border-white/10">
              <span class="text-[10px] text-slate-500 dark:text-zinc-400 uppercase block font-semibold">ACOUSTIC EMISSION</span>
              <span class="text-sm font-bold text-rose-600 dark:text-rose-400">412 eV/s <span class="text-[10px] font-normal">[HIGH]</span></span>
            </div>
          </div>
        </div>

        <!-- Right: LSTM Sequence Forecast Horizon (5 cols) -->
        <div class="xl:col-span-5 bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md border border-slate-200 dark:border-white/20 rounded-xl p-5 relative flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <div>
                <span class="font-['JetBrains_Mono'] text-[10px] tracking-widest text-amber-700 dark:text-amber-400 uppercase font-bold block mb-0.5">LSTM SEQUENCE FORECAST HORIZON</span>
                <h3 class="font-['Space_Grotesk'] text-base font-bold text-slate-900 dark:text-white">Time-to-Failure (TTF) Trajectory</h3>
              </div>
              <span class="font-['JetBrains_Mono'] text-xs font-bold px-2 py-1 rounded bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-700 dark:text-rose-400 uppercase">
                T-MINUS 04:31:12
              </span>
            </div>
            <p class="text-xs text-slate-600 dark:text-zinc-400 mb-3 leading-relaxed font-sans">
              Historical 24h MPU6050 displacement vector + projected 12h subsidence trajectory with 95% Bayesian confidence intervals.
            </p>

            <!-- Trajectory Graph SVG -->
            <div class="relative w-full h-56 bg-slate-50 dark:bg-[#05080c] rounded-lg border border-slate-200 dark:border-white/10 p-2">
              <svg class="w-full h-full" fill="none" viewbox="0 0 460 200" xmlns="http://www.w3.org/2000/svg">
                <line stroke="#e2e8f0" stroke-dasharray="2 2" stroke-width="0.8" x1="45" x2="445" y1="25" y2="25"></line>
                <line stroke="#e2e8f0" stroke-dasharray="2 2" stroke-width="0.8" x1="45" x2="445" y1="65" y2="65"></line>
                <line stroke="#e2e8f0" stroke-dasharray="2 2" stroke-width="0.8" x1="45" x2="445" y1="105" y2="105"></line>
                <line stroke="#cbd5e1" stroke-width="1" x1="45" x2="445" y1="145" y2="145"></line>
                
                <line stroke="#be123c" stroke-dasharray="4 3" stroke-width="1.5" x1="45" x2="445" y1="40" y2="40"></line>
                <text class="font-mono text-[8.5px] font-bold" fill="#be123c" x="50" y="34">CRITICAL COLLAPSE BOUNDARY (15.00mm DGMS LIMIT)</text>
                
                <line stroke="#0284c7" stroke-dasharray="3 2" stroke-width="1.2" x1="260" x2="260" y1="15" y2="155"></line>
                <text class="font-mono text-[8px] font-bold" fill="#0284c7" x="264" y="152">T=0 (NOW)</text>
                
                <polygon fill="#0284c7" fill-opacity="0.08" points="260,105 440,20 440,65 260,105"></polygon>
                <path d="M 45,142 Q 130,140 180,132 T 260,105" fill="none" stroke="#0284c7" stroke-width="2.5"></path>
                <path d="M 260,105 Q 330,80 375,40 T 440,26" fill="none" stroke="#be123c" stroke-dasharray="4 2" stroke-width="2.5"></path>
                
                <g class="font-mono text-[8.5px]" fill="#475569">
                  <text fill="#be123c" font-weight="bold" x="12" y="43">15mm</text>
                  <text x="12" y="68">10mm</text>
                  <text x="12" y="108">5mm</text>
                  <text x="12" y="148">0mm</text>
                </g>
                <g class="font-mono text-[8px]" fill="#475569">
                  <text x="45" y="165">-24H</text>
                  <text x="145" y="165">-12H</text>
                  <text fill="#0284c7" font-weight="bold" x="248" y="165">00:00 (LIVE)</text>
                  <text fill="#be123c" font-weight="bold" x="352" y="165">+4.5H TTF</text>
                  <text x="420" y="165">+12H</text>
                </g>
              </svg>
            </div>
