                <div class="flex-1 py-2 bg-white dark:bg-neutral-900 rounded border border-slate-200 dark:border-white/10 text-sky-700 dark:text-cyan-400 shadow-2xs">
                  <span class="block font-bold">NODE-01</span>
                  <span class="text-slate-500 dark:text-zinc-500 text-[9px]">Anchor</span>
                </div>
                <span class="text-slate-400 dark:text-zinc-600">→</span>
                <div class="flex-1 py-2 bg-amber-50 dark:bg-amber-500/10 rounded border border-amber-200 dark:border-amber-500/30 text-amber-800 dark:text-amber-300 shadow-2xs">
                  <span class="block font-bold">NODE-02</span>
                  <span class="text-slate-500 text-[9px]">Absorbing Shear</span>
                </div>
                <span class="text-rose-600 dark:text-rose-400 font-bold">⇒</span>
                <div class="flex-1 py-2 bg-rose-100 dark:bg-rose-500/20 rounded border border-rose-300 dark:border-rose-500/40 text-rose-800 dark:text-rose-300 shadow-2xs">
                  <span class="block font-bold">NODE-03</span>
                  <span class="text-slate-600 text-[9px]">Delaminating</span>
                </div>
                <span class="text-slate-400 dark:text-zinc-600">→</span>
                <div class="flex-1 py-2 bg-white dark:bg-neutral-900 rounded border border-slate-200 dark:border-white/10 text-sky-700 dark:text-cyan-400 shadow-2xs">
                  <span class="block font-bold">NODE-04</span>
                  <span class="text-slate-500 dark:text-zinc-500 text-[9px]">Surface Datum</span>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-200 dark:border-white/10 flex items-center justify-between text-slate-500 dark:text-zinc-400 font-['JetBrains_Mono'] text-xs">
            <span>RF RSSI SX1278 BUS: -94 dBm avg</span>
            <span class="text-sky-700 dark:text-cyan-400 font-semibold">NODE-03 RE-POLL: 12 SEC INTERVAL</span>
          </div>
        </div>
      </div>

      <!-- 7. BOTTOM SECTION: DGMS Emergency Interlock & Action Priorities -->
      <div class="bg-white dark:bg-[#0b0f19]/90 backdrop-blur-md border border-slate-200 dark:border-white/20 rounded-xl p-5 relative shadow-sm">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-5">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-['JetBrains_Mono'] text-[10px] text-rose-700 dark:text-rose-400 uppercase font-bold tracking-widest px-2 py-0.5 bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 rounded">
                DGMS REGULATION 124 COMPLIANCE TRIGGER
              </span>
              <span class="font-['JetBrains_Mono'] text-xs text-slate-500 dark:text-zinc-400 font-semibold">• AUTOMATED SAFETY INTERLOCK</span>
            </div>
            <h2 class="font-['Space_Grotesk'] text-lg font-bold text-slate-900 dark:text-white mt-1">Geotechnical Mitigation &amp; Emergency Dispatch Engine</h2>
          </div>
          <div class="flex items-center gap-3">
            <div class="bg-slate-50 dark:bg-[#05080c] border border-slate-200 dark:border-white/10 px-3 py-1.5 rounded text-right font-['JetBrains_Mono']">
              <span class="text-[9px] text-slate-500 dark:text-zinc-400 uppercase block font-semibold">CIVIL DEFENSE COMS</span>
              <span class="text-xs text-sky-700 dark:text-cyan-400 font-bold">READY (DHANBAD HQ)</span>
            </div>
            <div class="bg-slate-50 dark:bg-[#05080c] border border-slate-200 dark:border-white/10 px-3 py-1.5 rounded text-right font-['JetBrains_Mono']">
              <span class="text-[9px] text-slate-500 dark:text-zinc-400 uppercase block font-semibold">FORM-IV GENERATOR</span>
              <span class="text-xs text-emerald-700 dark:text-emerald-400 font-bold">SERIALIZED #9928-DG</span>
            </div>
          </div>
        </div>

        <!-- 3 Action Priority Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-2">
          <!-- Priority 1 -->
          <div class="bg-slate-50 dark:bg-[#05080c] border border-slate-200 dark:border-white/10 p-4 rounded-xl flex flex-col justify-between shadow-xs">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="px-2 py-0.5 bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-700 dark:text-rose-400 font-['JetBrains_Mono'] text-[10px] font-bold uppercase rounded">
                  ACTION PRIORITY 1
                </span>
                <span class="material-symbols-outlined text-rose-600 dark:text-rose-400 text-[20px]">warning</span>
              </div>
              <h4 class="font-['Space_Grotesk'] text-sm font-bold text-slate-900 dark:text-white mb-1">Sector 4B Immediate Worker Withdrawal</h4>
              <p class="text-xs text-slate-600 dark:text-zinc-300 leading-relaxed font-sans">
                Initiate withdrawal of all underground mining personnel from Drift 12 through Incline 3. Estimated personnel in zone: 18 miners.
              </p>
            </div>
            <div class="mt-4">
              <button class="w-full py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded font-['JetBrains_Mono'] text-xs uppercase tracking-wider font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer active:scale-95 shadow" ng-click="vm.openEvacModal()">
                <span class="material-symbols-outlined text-[16px]">notifications_active</span> BROADCAST KLAXON EVACUATION
              </button>
            </div>
          </div>

          <!-- Priority 2 -->
          <div class="bg-slate-50 dark:bg-[#05080c] border border-slate-200 dark:border-white/10 p-4 rounded-xl flex flex-col justify-between shadow-xs">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="px-2 py-0.5 bg-amber-50 dark:bg-amber-500/20 border border-amber-200 dark:border-amber-500/40 text-amber-800 dark:text-amber-300 font-['JetBrains_Mono'] text-[10px] font-bold uppercase rounded">
                  ACTION PRIORITY 2
                </span>
                <span class="material-symbols-outlined text-amber-600 dark:text-amber-400 text-[20px]">water_pump</span>
              </div>
              <h4 class="font-['Space_Grotesk'] text-sm font-bold text-slate-900 dark:text-white mb-1">Remote Sump Dewatering Override</h4>
              <p class="text-xs text-slate-600 dark:text-zinc-300 leading-relaxed font-sans">
                Engage high-capacity 500GPM turbine pump at Shaft 12 sump to drop hydrostatic pressure across Seam V sandstone contact horizon.
              </p>
            </div>
            <div class="mt-4">
              <button class="w-full py-2.5 font-['JetBrains_Mono'] text-xs uppercase tracking-wider font-bold rounded transition-all flex items-center justify-center gap-1.5 cursor-pointer active:scale-95 shadow" ng-class="vm.isPumpActive ? 'bg-sky-600 text-white border border-sky-500 dark:bg-cyan-400 dark:text-black font-extrabold shadow-md' : 'bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-300 dark:bg-cyan-500/10 dark:hover:bg-cyan-500/20 dark:text-cyan-300 dark:border-cyan-500/40'" ng-click="vm.togglePump()">
                <span class="material-symbols-outlined text-[16px]">power_settings_new</span>
                <span>{{ vm.isPumpActive ? 'PUMP ACTIVE (500 GPM ENGAGED)' : 'ENGAGE SUMP PUMP OVERRIDE' }}</span>
              </button>
            </div>
          </div>

          <!-- Priority 3 -->
          <div class="bg-slate-50 dark:bg-[#05080c] border border-slate-200 dark:border-white/10 p-4 rounded-xl flex flex-col justify-between shadow-xs">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="px-2 py-0.5 bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-200 dark:border-emerald-500/40 text-emerald-800 dark:text-emerald-300 font-['JetBrains_Mono'] text-[10px] font-bold uppercase rounded">
                  REGULATORY COMPLIANCE
                </span>
                <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-[20px]">send_and_archive</span>
              </div>
              <h4 class="font-['Space_Grotesk'] text-sm font-bold text-slate-900 dark:text-white mb-1">Transmit DGMS Form-IV Hazard Dossier</h4>
              <p class="text-xs text-slate-600 dark:text-zinc-300 leading-relaxed font-sans">
                Digitally dispatch compiled sensor logs, Bayesian failure trajectory, and SHAP attribution graphs to Mines Safety Inspectorate via encrypted link.
              </p>
            </div>
            <div class="mt-4">
              <button class="w-full py-2.5 font-['JetBrains_Mono'] text-xs uppercase tracking-wider font-bold rounded transition-all flex items-center justify-center gap-1.5 cursor-pointer active:scale-95 shadow" ng-class="vm.dossierSent ? 'bg-emerald-100 text-emerald-900 border border-emerald-400 dark:bg-emerald-500/30 dark:text-emerald-200 shadow-sm' : 'bg-slate-800 hover:bg-slate-900 text-white dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:text-zinc-200 border border-slate-700 dark:border-white/20'" ng-click="vm.transmitDossier()">
                <span class="material-symbols-outlined text-[16px]">{{ vm.dossierSent ? 'done_all' : 'description' }}</span>
                <span>{{ vm.dossierSent ? 'DOSSIER #9928-DG DISPATCHED' : 'TRANSMIT DGMS INCIDENT DOSSIER' }}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- DGMS Statutory Emergency Evacuation Dispatch Component -->
  <evacuation-modal is-open="vm.isEvacModalOpen" telemetry="vm.telemetry" on-close="vm.closeEvacModal()" on-confirm="vm.confirmEvacDispatch()"></evacuation-modal>

  <!-- Floating Cyber HUD AI Chat Assistant Widget -->
  <!-- Command Palette (Ctrl+K) -->
  <div ng-controller="CommandPaletteController as cp">
    <div ng-if="cp.isOpen" class="cmd-palette-backdrop" ng-click="$event.target === $event.currentTarget && cp.close()">
      <div class="cmd-palette-modal">
        <div class="flex items-center gap-3 px-4 border-b border-white/10">
          <span class="material-symbols-outlined text-slate-400 dark:text-zinc-400 text-[18px]">search</span>
          <input id="cmd-palette-input" type="text" class="cmd-palette-input" ng-model="cp.query" ng-change="cp.filterCommands()" placeholder="Search commands... (↑↓ to navigate, Enter to run, Esc to close)" autocomplete="off" />
          <kbd class="text-slate-500 dark:text-zinc-500 font-['JetBrains_Mono'] text-[10px] border border-white/10 px-1.5 py-0.5 rounded">ESC</kbd>
        </div>
        <div class="py-2 max-h-[55vh] overflow-y-auto">
          <div ng-if="cp.filtered.length === 0" class="px-6 py-8 text-center font-['JetBrains_Mono'] text-[12px] text-slate-500 dark:text-zinc-500">No commands match "{{ cp.query }}"</div>
          <div ng-repeat="cmd in cp.filtered track by $index" class="cmd-palette-item" ng-class="$index === cp.activeIndex ? 'active' : ''" ng-click="cp.execute(cmd)">
            <div class="w-7 h-7 rounded-lg flex items-center justify-center bg-white/5 flex-shrink-0">
              <span class="material-symbols-outlined text-[16px]" ng-class="cp.getCategoryColor(cmd.category)">{{ cmd.icon }}</span>
            </div>
            <div class="flex-1 min-w-0">
              <span class="font-['Space_Grotesk'] text-[13px] font-semibold text-slate-900 dark:text-white block">{{ cmd.label }}</span>
            </div>
            <span class="font-['JetBrains_Mono'] text-[9px] font-bold uppercase px-2 py-0.5 rounded-full border" ng-class="cp.getCategoryColor(cmd.category)" style="border-color: currentColor; opacity: 0.7;">{{ cmd.category }}</span>
          </div>
        </div>
        <div class="px-4 py-2 border-t border-white/8 flex items-center gap-3 font-['JetBrains_Mono'] text-[9px] text-slate-500 dark:text-zinc-500">
          <span><kbd class="bg-white/10 px-1.5 py-0.5 rounded text-white/60">↑↓</kbd> navigate</span>
          <span><kbd class="bg-white/10 px-1.5 py-0.5 rounded text-white/60">↵</kbd> execute</span>
          <span class="ml-auto">{{ cp.filtered.length }} commands</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Officer Chain-of-Custody Acknowledgement Modal -->
  <div ng-if="ml.isOfficerAckOpen" class="audit-modal-backdrop" ng-click="$event.target === $event.currentTarget && ml.closeOfficerAck()">
    <div class="audit-modal" style="max-width: 480px;">
      <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-emerald-400 text-[22px]">verified_user</span>
          <div class="font-['Space_Grotesk'] text-[16px] font-bold text-slate-900 dark:text-white">{{ ml.t('OFFICER ACKNOWLEDGEMENT', 'अधिकारी अभिस्वीकृति') }}</div>
        </div>
        <button ng-click="ml.closeOfficerAck()" class="text-slate-400 hover:text-white transition cursor-pointer"><span class="material-symbols-outlined">close</span></button>
      </div>
      <div class="px-6 py-4 space-y-3">
        <p class="font-['Space_Grotesk'] text-[13px] text-slate-600 dark:text-zinc-300 leading-relaxed">
          {{ ml.t('Record officer chain-of-custody for this anomaly event. This will be logged in the DGMS statutory audit trail.', 'इस विसंगति घटना के लिए अधिकारी श्रृंखला-की-हिरासत दर्ज करें।') }}
        </p>
        <div>
          <label class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-zinc-400 uppercase block mb-1">{{ ml.t('Officer Name', 'अधिकारी नाम') }}</label>
          <input type="text" ng-model="ml.officerName" placeholder="Er. R. Sharma" class="w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/20 rounded-lg px-3 py-2 font-['JetBrains_Mono'] text-[12px] text-slate-900 dark:text-white focus:outline-none focus:border-sky-500" />
        </div>
        <div>
          <label class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-zinc-400 uppercase block mb-1">{{ ml.t('DGMS Badge ID', 'डीजीएमएस बैज आईडी') }}</label>
          <input type="text" ng-model="ml.officerBadge" placeholder="DGMS-JH-2024-0042" class="w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/20 rounded-lg px-3 py-2 font-['JetBrains_Mono'] text-[12px] text-slate-900 dark:text-white focus:outline-none focus:border-sky-500" />
        </div>
        <div>
          <label class="font-['JetBrains_Mono'] text-[10px] text-slate-500 dark:text-zinc-400 uppercase block mb-1">{{ ml.t('Mitigation Action', 'शमन कार्रवाई') }}</label>
          <textarea ng-model="ml.officerMitigation" placeholder="e.g. Increased prop density at Pillar 4B. Reduced extraction rate to 60%." rows="2" class="w-full bg-slate-50 dark:bg-white/5 border border-slate-300 dark:border-white/20 rounded-lg px-3 py-2 font-['Space_Grotesk'] text-[12px] text-slate-900 dark:text-white focus:outline-none focus:border-sky-500 resize-none"></textarea>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-slate-200 dark:border-white/10 flex items-center gap-3">
        <button ng-click="ml.closeOfficerAck()" class="px-4 py-2 rounded-lg border border-slate-300 dark:border-white/20 text-slate-600 dark:text-zinc-400 font-['JetBrains_Mono'] text-[11px] uppercase font-bold transition cursor-pointer">{{ ml.t('Cancel', 'रद्द करें') }}</button>
        <button ng-click="ml.submitOfficerAck()" ng-disabled="!ml.officerName" class="flex-1 py-2 rounded-lg font-['JetBrains_Mono'] text-[11px] uppercase font-bold flex items-center justify-center gap-2 transition cursor-pointer" ng-class="ml.officerName ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-md' : 'bg-slate-200 dark:bg-white/10 text-slate-400 cursor-not-allowed'">
          <span class="material-symbols-outlined text-[15px]">check_circle</span> {{ ml.t('SUBMIT ACKNOWLEDGEMENT', 'अभिस्वीकृति जमा करें') }}
        </button>
      </div>
    </div>
  </div>

  <%- include('partials/chat-widget') %>
</body>
</html>
