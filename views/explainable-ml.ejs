                <span id="dossier-status-text">TRANSMIT DGMS INCIDENT DOSSIER</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Interactive Physics Twin Ribbon -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-outline-variant/40 font-mono text-xs">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-on-surface-variant uppercase text-[10px]">INTERACTIVE PHYSICS TWIN:</span>
            <button class="px-3 py-1.5 bg-primary/10 hover:bg-primary hover:text-on-primary text-primary border border-primary/30 rounded font-bold uppercase tracking-wider transition-colors flex items-center gap-1.5" onclick="runSimulation()">
              <span class="material-symbols-outlined text-[15px]">model_training</span> SIMULATE STRATA LOAD MITIGATION
            </button>
            <span class="text-primary-container hidden font-semibold" id="sim-feedback">Simulating 20% Hydraulic Relief: TTF extended by +6.2h</span>
          </div>
          <div class="flex items-center gap-1 text-on-surface-variant text-[11px]">
            <span>HARDWARE VERIFIED:</span>
            <span class="text-primary font-bold">SX1278 // MPU6050 // HC-SR04 // NEO-6M</span>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Interactive Evacuation Confirmation Modal -->
  <div class="fixed inset-0 bg-surface-container-lowest/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden" id="evac-modal">
    <div class="bg-surface-container-low max-w-lg w-full p-6 rounded border border-error/50 shadow-2xl relative">
      <span class="hud-bracket-tl">┌</span><span class="hud-bracket-tr">┐</span>
      <span class="hud-bracket-bl">└</span><span class="hud-bracket-br">┘</span>
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded bg-error/20 border border-error/40 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-error text-[28px] animate-pulse">crisis_alert</span>
        </div>
        <div>
          <span class="font-mono text-[10px] text-error uppercase font-bold tracking-wider block">CRITICAL SAFETY OVERRIDE</span>
          <h3 class="font-display text-lg font-bold text-primary">Initiate Sector 4B Evacuation Klaxon</h3>
        </div>
      </div>
      <p class="text-xs text-on-surface-variant mb-4 leading-relaxed">
        This action activates underground acoustic audio horns across Sector 4B &amp; Shaft 12, cuts non-essential power to gallery drilling equipment, and broadcasts LoRa packets commanding emergency beacons to strobe.
      </p>
      <div class="bg-surface-container-lowest border border-outline-variant/40 p-3 rounded mb-5 font-mono text-xs space-y-1.5">
        <div class="flex justify-between">
          <span class="text-on-surface-variant">AFFECTED REGION:</span>
          <span class="text-primary font-bold">CHASNALA DEEP MINE // SEC-4B</span>
        </div>
        <div class="flex justify-between">
          <span class="text-on-surface-variant">CRITICAL SENSOR:</span>
          <span class="text-error font-bold">NODE-03 (PILLAR 4B TILT 3.12°/hr)</span>
        </div>
        <div class="flex justify-between">
          <span class="text-on-surface-variant">TELEMETRY TIMEOUT:</span>
          <span class="text-secondary font-bold">TTF T-MINUS 04:31:12</span>
        </div>
      </div>
      <div class="flex items-center justify-end gap-3 font-mono text-xs">
        <button class="px-4 py-2 bg-surface-container-high hover:bg-surface-container-highest text-on-surface border border-outline-variant/50 rounded uppercase tracking-wider" onclick="document.getElementById('evac-modal').classList.add('hidden')">
          CANCEL / ABORT
        </button>
        <button class="px-4 py-2 bg-error text-white hover:bg-error/90 border border-error/50 rounded uppercase tracking-wider font-bold shadow-[0_0_12px_rgba(255,77,109,0.35)]" onclick="confirmEvacuation()">
          CONFIRM EMERGENCY BROADCAST
        </button>
      </div>
    </div>
  </div>

  <script>
    function togglePump() {
      const btn = document.getElementById('btn-pump');
      const text = document.getElementById('pump-status-text');
      if (btn.classList.contains('bg-secondary-container')) {
        btn.classList.remove('bg-secondary-container', 'text-black');
        btn.classList.add('bg-primary-container/10', 'text-primary-container');
        text.innerText = 'ENGAGE SUMP PUMP OVERRIDE';
      } else {
        btn.classList.add('bg-secondary-container', 'text-black');
        btn.classList.remove('bg-primary-container/10', 'text-primary-container');
        text.innerText = 'OVERRIDE RUNNING (500 GPM ACTIVE)';
      }
    }

    function transmitDossier() {
      const text = document.getElementById('dossier-status-text');
      text.innerText = 'TRANSMITTING VIA ENCRYPTED UPLINK...';
      setTimeout(() => {
        text.innerText = 'DISPATCH ACKNOWLEDGED (DGMS-OK #9928)';
      }, 1200);
    }

    function runSimulation() {
      const fb = document.getElementById('sim-feedback');
      fb.classList.remove('hidden');
    }

    function confirmEvacuation() {
      const modal = document.getElementById('evac-modal');
      modal.classList.add('hidden');
      alert("EMERGENCY KLAXON BROADCASTED: Evacuation sequence initiated across Sector 4B Shaft 12.");
    }

    // Header live clock
    setInterval(() => {
      const d = new Date();
      const timeStr = d.toLocaleTimeString('en-US', { hour12: false }) + ' IST';
      const clockEl = document.getElementById('header-clock');
      if (clockEl) clockEl.innerText = timeStr + ' UTC+5:30 REAL-TIME';
    }, 1000);

    // Live ML Telemetry Simulation
    setInterval(() => {
      const latencyEl = document.getElementById('ml-latency');
      if (latencyEl) {
        latencyEl.innerText = (18 + Math.floor(Math.random() * 8 - 4)) + 'ms';
      }
      const bayesEl = document.getElementById('ml-bayes');
      if (bayesEl) {
        bayesEl.innerText = (94 + Math.random() * 2).toFixed(1) + '%';
      }
    }, 2500);
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    socket.on('telemetry', (data) => {
      const el = (id) => document.getElementById(id);
      
      // Animate Delamination Polygon based on strain/disp
      const polygon = el('delam-polygon');
      if (polygon) {
        const strainScale = 1.0 + (data.disp * 0.5);
        polygon.setAttribute('transform', `scale(${strainScale}) translate(${-(strainScale-1)*370}, ${-(strainScale-1)*210})`);
      }

      // Update Zone Max Flexure text
      if (el('zone-max-flexure')) {
        el('zone-max-flexure').innerText = (14.18 + (data.disp * 5)).toFixed(2);
      }

      // Update TreeSHAP attribution bars dynamically
      if (el('shap-1')) el('shap-1').style.width = `${Math.min(100, 38.4 + (Math.abs(data.pitch) * 5))}%`;
      if (el('shap-2')) el('shap-2').style.width = `${Math.min(100, 27.1 + (data.rms * 50))}%`;
      if (el('shap-3')) el('shap-3').style.width = `${Math.min(100, 14.8 + (data.co / 2))}%`;

      // Live AI Analyst Logic
      const aiTextEl = el('ai-insight-text');
      if (data.aiText && data.aiText !== currentAiText) {
        currentAiText = data.aiText;
        clearInterval(typewriterInterval);
        aiTextEl.innerText = "";
        let charIndex = 0;
        typewriterInterval = setInterval(() => {
          if (charIndex < currentAiText.length) {
            aiTextEl.innerText += currentAiText.charAt(charIndex);
            charIndex++;
          } else {
            clearInterval(typewriterInterval);
          }
        }, 30);
      }
    });

    let currentAiText = null;
    let typewriterInterval = null;
  </script>
</body>
</html>
