  <!-- Cesium 3D Globe & God's Eye View Logic -->
  <script>
    let viewer = null;
    let mineEntity = null;
    let isShowingIframe = false;
    let localGevUrl = localStorage.getItem('gev_instance_url') || 'http://localhost:4173';

    // Chasnala Deep Mine Target Coordinates
    const MINE_LAT = 23.795741;
    const MINE_LON = 86.430412;
    const MINE_ALT = 184.2;

    function initCesiumGlobe() {
      try {
        const esriAsync = Cesium.ArcGisMapServerImageryProvider.fromUrl(
          'https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer',
          { enablePickFeatures: false }
        ).catch(function(err) {
          console.warn('Esri World Imagery fallback to OSM:', err);
          return Cesium.OpenStreetMapImageryProvider.fromUrl('https://tile.openstreetmap.org/');
        });

        // Initialize Cesium Viewer with Photorealistic Natural Satellite Earth Imagery (ArcGIS World Imagery)
        viewer = new Cesium.Viewer('cesiumContainer', {
          baseLayer: Cesium.ImageryLayer.fromProviderAsync(esriAsync),
          baseLayerPicker: false,
          geocoder: false,
          homeButton: false,
          infoBox: false,
          sceneModePicker: false,
          selectionIndicator: false,
          timeline: false,
          navigationHelpButton: false,
          animation: false,
          shouldAnimate: true
        });

        // Set natural dark baseColor and space lighting
        viewer.scene.globe.baseColor = Cesium.Color.fromCssColorString('#0b101b');
        viewer.scene.globe.enableLighting = true;
        viewer.scene.globe.depthTestAgainstTerrain = false;
        viewer.scene.backgroundColor = Cesium.Color.fromCssColorString('#020408');

        // 1. Natural Geological Strata: Subterranean Coal Seam Volume (Anthracite Black)
        viewer.entities.add({
          name: 'Chasnala Main Coal Seam #14 (Subterranean Anthracite)',
          position: Cesium.Cartesian3.fromDegrees(MINE_LON, MINE_LAT, MINE_ALT - 25),
          cylinder: {
            length: 18.0,
            topRadius: 180.0,
            bottomRadius: 210.0,
            material: Cesium.Color.fromCssColorString('#18181b').withAlpha(0.85),
            outline: true,
            outlineColor: Cesium.Color.fromCssColorString('#3f3f46').withAlpha(0.6)
          }
        });

        // 2. Natural Geological Strata: Overburden Sandstone Caprock (Warm Terracotta/Ochre)
        viewer.entities.add({
          name: 'Overburden Sandstone Stratum',
          position: Cesium.Cartesian3.fromDegrees(MINE_LON, MINE_LAT, MINE_ALT + 8),
          cylinder: {
            length: 12.0,
            topRadius: 240.0,
            bottomRadius: 260.0,
            material: Cesium.Color.fromCssColorString('#d97706').withAlpha(0.35),
            outline: true,
            outlineColor: Cesium.Color.fromCssColorString('#b45309').withAlpha(0.7)
          }
        });

        // 3. Natural Hydrogeology: Subsurface Mine Sump & Water Horizon (Crystalline Blue)
        viewer.entities.add({
          name: 'REL_35 Underground Sump Basin (Water Table Reservoir)',
          position: Cesium.Cartesian3.fromDegrees(MINE_LON - 0.0022, MINE_LAT - 0.0031, MINE_ALT - 42),
          cylinder: {
            length: 8.0,
            topRadius: 90.0,
            bottomRadius: 90.0,
            material: Cesium.Color.fromCssColorString('#0284c7').withAlpha(0.65),
            outline: true,
            outlineColor: Cesium.Color.fromCssColorString('#38bdf8')
          }
        });

        // 4. Natural 3D Sensor Node Markers
        // Node 01: Shaft #2 North Drift (Natural Forest Emerald - Safe)
        viewer.entities.add({
          name: 'NODE-01: Shaft #2 North Drift',
          position: Cesium.Cartesian3.fromDegrees(MINE_LON - 0.0035, MINE_LAT + 0.0028, MINE_ALT + 22.5),
          point: {
            pixelSize: 11,
            color: Cesium.Color.fromCssColorString('#10b981'),
            outlineColor: Cesium.Color.fromCssColorString('#064e3b'),
            outlineWidth: 2
          },
          label: {
            text: 'NODE-01 [SHAFT #2 OK]',
            font: '10px JetBrains Mono, monospace',
            style: Cesium.LabelStyle.FILL_AND_OUTLINE,
            fillColor: Cesium.Color.fromCssColorString('#6ee7b7'),
            outlineColor: Cesium.Color.BLACK,
            outlineWidth: 2,
            verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
            pixelOffset: new Cesium.Cartesian2(0, -14)
          }
        });

        // Node 02: Haul Road Overburden (Natural Topaz Amber - Watch)
        viewer.entities.add({
          name: 'NODE-02: Overburden Haul Road',
          position: Cesium.Cartesian3.fromDegrees(MINE_LON + 0.0042, MINE_LAT + 0.0015, MINE_ALT + 45.0),
          point: {
            pixelSize: 11,
            color: Cesium.Color.fromCssColorString('#f59e0b'),
            outlineColor: Cesium.Color.fromCssColorString('#78350f'),
            outlineWidth: 2
          },
          label: {
            text: 'NODE-02 [OVERBURDEN WATCH]',
            font: '10px JetBrains Mono, monospace',
            style: Cesium.LabelStyle.FILL_AND_OUTLINE,
            fillColor: Cesium.Color.fromCssColorString('#fcd34d'),
            outlineColor: Cesium.Color.BLACK,
            outlineWidth: 2,
            verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
            pixelOffset: new Cesium.Cartesian2(0, -14)
          }
        });

        // Node 04: Sub-Gallery Sump (Natural Water Cyan - Safe/Aquifer)
        viewer.entities.add({
          name: 'NODE-04: Sub-Gallery Sump Basin',
          position: Cesium.Cartesian3.fromDegrees(MINE_LON - 0.0022, MINE_LAT - 0.0031, MINE_ALT - 30.0),
          point: {
            pixelSize: 11,
            color: Cesium.Color.fromCssColorString('#0ea5e9'),
            outlineColor: Cesium.Color.fromCssColorString('#0c4a6e'),
            outlineWidth: 2
          },
          label: {
            text: 'NODE-04 [SUMP RESERVOIR]',
            font: '10px JetBrains Mono, monospace',
            style: Cesium.LabelStyle.FILL_AND_OUTLINE,
            fillColor: Cesium.Color.fromCssColorString('#7dd3fc'),
            outlineColor: Cesium.Color.BLACK,
            outlineWidth: 2,
            verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
            pixelOffset: new Cesium.Cartesian2(0, -14)
          }
        });

        // 5. Node 03 Focal Beacon (Natural Ruby Alert - Critical Subsidence Monitoring)
        mineEntity = viewer.entities.add({
          name: 'Chasnala Deep Mine - Sector 4B Stope',
          position: Cesium.Cartesian3.fromDegrees(MINE_LON, MINE_LAT, MINE_ALT + 30),
          point: {
            pixelSize: 16,
            color: Cesium.Color.fromCssColorString('#ef4444'),
            outlineColor: Cesium.Color.WHITE,
            outlineWidth: 3
          },
          label: {
            text: 'TARGET: NODE-03 SEC-4B\n[ACTIVE STOPE PILLAR]',
            font: '11px JetBrains Mono, monospace',
            style: Cesium.LabelStyle.FILL_AND_OUTLINE,
            fillColor: Cesium.Color.fromCssColorString('#fca5a5'),
            outlineColor: Cesium.Color.BLACK,
            outlineWidth: 2,
            verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
            pixelOffset: new Cesium.Cartesian2(0, -20)
          }
        });

        // 6. Natural 3D Subsidence Displacement Vector Ray
        viewer.entities.add({
          name: 'Differential Strata Subsidence Vector',
          polyline: {
            positions: Cesium.Cartesian3.fromDegreesArrayHeights([
              MINE_LON, MINE_LAT, MINE_ALT + 30,
              MINE_LON + 0.0008, MINE_LAT - 0.0012, MINE_ALT - 35
            ]),
            width: 4,
            material: new Cesium.PolylineGlowMaterialProperty({
              glowPower: 0.35,
              color: Cesium.Color.fromCssColorString('#f43f5e')
            })
          }
        });

        // Load live GeoJSON Spatial Mine Layer
        loadGeoJsonLayer();

        // Fly directly to Mine on startup
        flyToMine();

      } catch (err) {
        console.warn('Cesium WebGL notice (falling back to tactical satellite canvas):', err.message);
      }
    }

    let currentGeoJsonSource = null;
    function loadGeoJsonLayer() {
      if (!viewer) return;
      Cesium.GeoJsonDataSource.load('/api/telemetry/geojson', {
        stroke: Cesium.Color.fromCssColorString('#ef4444'),
        fill: Cesium.Color.fromCssColorString('#ef4444').withAlpha(0.3),
        strokeWidth: 3,
        markerSize: 24
      }).then(function(dataSource) {
        if (currentGeoJsonSource) {
          viewer.dataSources.remove(currentGeoJsonSource, true);
        }
        currentGeoJsonSource = dataSource;
        viewer.dataSources.add(dataSource);
        const entities = dataSource.entities.values;
        for (let i = 0; i < entities.length; i++) {
          const entity = entities[i];
          const hexColor = (entity.properties && entity.properties.color && entity.properties.color.getValue()) || '#10b981';
          if (entity.billboard) {
            entity.billboard.color = Cesium.Color.fromCssColorString(hexColor);
          }
          if (entity.point) {
            entity.point.color = Cesium.Color.fromCssColorString(hexColor);
          }
        }
      }).catch(function(e) {
        console.warn('[GEV Engine] GeoJSON layer notice:', e.message);
      });
    }
    setInterval(loadGeoJsonLayer, 4000);

    function flyToMine() {
      if (!viewer) return;
      viewer.camera.flyTo({
        destination: Cesium.Cartesian3.fromDegrees(MINE_LON, MINE_LAT, 2500),
        orientation: {
          heading: Cesium.Math.toRadians(15.0),
          pitch: Cesium.Math.toRadians(-45.0),
          roll: 0.0
        },
        duration: 2.5
      });
    }

    function resetGlobe() {
      if (!viewer) return;
      viewer.camera.flyTo({
        destination: Cesium.Cartesian3.fromDegrees(MINE_LON, MINE_LAT, 15000000),
        orientation: {
          heading: 0,
          pitch: Cesium.Math.toRadians(-90.0),
          roll: 0.0
        },
        duration: 3.0
      });
    }

    // Keyboard Hotkeys matching God's Eye View standards
    document.addEventListener('keydown', (e) => {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
      switch (e.key) {
        case '1': setOptic('normal'); break;
        case '2': setOptic('flir'); break;
        case '3': setOptic('nvg'); break;
        case '4': setOptic('crt'); break;
        case 'c':
        case 'C': flyToMine(); break;
        case 'Escape': resetGlobe(); break;
      }
    });


    function setOptic(type) {
      const container = document.getElementById('cesiumContainer');
      const buttons = ['normal', 'flir', 'nvg', 'crt'];
      
      buttons.forEach(b => {
        const btn = document.getElementById(`btn-optic-${b}`);
        if (btn) {
          if (b === type) {
            btn.className = 'px-2 py-1 rounded bg-white text-black border border-white text-[10px] font-bold uppercase transition active:scale-95';
          } else {
            btn.className = 'px-2 py-1 rounded bg-neutral-900 hover:bg-neutral-800 text-zinc-300 text-[10px] font-bold uppercase transition active:scale-95';
          }
        }
      });

      if (container) {
        container.classList.remove('optic-flir', 'optic-nvg', 'optic-crt');
        if (type !== 'normal') {
          container.classList.add(`optic-${type}`);
        }
      }
    }

    function toggleGlobeOrIframe() {
      isShowingIframe = !isShowingIframe;
      const cesiumEl = document.getElementById('cesiumContainer');
      const iframeEl = document.getElementById('pairedIframeContainer');
      const iframe = document.getElementById('gevIframe');
      const toggleText = document.getElementById('source-toggle-text');

      if (isShowingIframe) {
        if (cesiumEl) cesiumEl.classList.add('hidden');
        if (iframeEl) iframeEl.classList.remove('hidden');
        if (iframe && iframe.src === 'about:blank') {
          iframe.src = `${localGevUrl}?lat=${MINE_LAT}&lon=${MINE_LON}&alt=${MINE_ALT}`;
        }
        if (toggleText) toggleText.innerText = 'Switch to Embedded 3D';
      } else {
        if (cesiumEl) cesiumEl.classList.remove('hidden');
        if (iframeEl) iframeEl.classList.add('hidden');
        if (toggleText) toggleText.innerText = 'Switch to Paired GEV App';
      }
    }

    function openPairingModal() {
      const modal = document.getElementById('pairing-modal');
      const input = document.getElementById('gev-url-input');
      if (input) input.value = localGevUrl;
      if (modal) modal.classList.remove('hidden');
    }

    function closePairingModal() {
      const modal = document.getElementById('pairing-modal');
      if (modal) modal.classList.add('hidden');
    }

    function saveAndPairGev() {
      const input = document.getElementById('gev-url-input');
      if (input && input.value.trim()) {
        localGevUrl = input.value.trim();
        localStorage.setItem('gev_instance_url', localGevUrl);
        closePairingModal();
        checkGevStatus();
        alert(`God's Eye View linked to: ${localGevUrl}`);
      }
    }

    function testGevConnection() {
      const input = document.getElementById('gev-url-input');
      const url = (input ? input.value.trim() : localGevUrl) || 'http://localhost:4173';
      
      fetch(url, { mode: 'no-cors' })
        .then(() => alert(`SUCCESS: Reachable at ${url}! Ready for 3D pairing.`))
        .catch(err => alert(`Notice: ${url} not responding yet. Ensure 'npm run dev' is running in gods-eye-view folder.`));
    }

    function checkGevStatus() {
      const badge = document.getElementById('gev-instance-badge');
      if (!badge) return;

      fetch(localGevUrl, { mode: 'no-cors' })
        .then(() => {
          badge.className = 'px-1.5 py-0.2 rounded text-[8px] bg-white text-black font-bold font-mono';
          badge.innerText = `● PAIRED: ${localGevUrl}`;
        })
        .catch(() => {
          badge.className = 'px-1.5 py-0.2 rounded text-[8px] bg-neutral-900 text-zinc-400 border border-white/10 font-mono';
          badge.innerText = `STANDBY: ${localGevUrl}`;
        });
    }

    function copyGeoJsonUrl() {
      const input = document.getElementById('geojson-input');
      if (input) {
        navigator.clipboard.writeText(input.value);
        alert('Live GeoJSON URL copied to clipboard! Paste into God\'s Eye View or Cesium ion.');
      }
    }

    // Connect WebSocket for live telemetry synchronization
    const socket = io();
    socket.on('telemetry', (data) => {
      if (!data) return;

      const el = (id) => document.getElementById(id);
      if (el('side-tilt')) el('side-tilt').innerText = `Pitch: ${Number(data.pitch).toFixed(2)}° | Roll: ${Number(data.roll).toFixed(2)}°`;
      if (el('side-disp')) el('side-disp').innerText = `${Number(data.disp).toFixed(2)}° Σ (${data.phase})`;
      if (el('side-water')) el('side-water').innerText = `${Number(data.sump).toFixed(2)} m / 4.00 m`;
      if (el('side-rms')) el('side-rms').innerText = `${Number(data.rms).toFixed(2)} g (${Number(data.fft || 48.0).toFixed(1)} Hz)`;
      if (el('side-temp')) el('side-temp').innerText = `${Number(data.temp).toFixed(1)} °C`;
      if (el('side-hum')) el('side-hum').innerText = `${Number(data.humidity || 78.5).toFixed(1)}% RH`;
      if (el('side-ai-directive') && data.aiText) el('side-ai-directive').innerText = data.aiText;

      if (data.lat && el('hud-coords')) el('hud-coords').innerText = `${Number(data.lat).toFixed(6)}° N, ${Number(data.lon).toFixed(6)}° E`;
      if (data.alt && el('hud-alt')) el('hud-alt').innerText = `${Number(data.alt).toFixed(2)} m MSL`;
      if (el('gev-latency')) el('gev-latency').innerText = `${data.latency}ms`;

      // Update 3D Pin Point Color with natural geotechnical status colors
      if (mineEntity && mineEntity.point) {
        if (data.phase === 'CRITICAL') {
          mineEntity.point.color = Cesium.Color.fromCssColorString('#ef4444');
        } else if (data.phase === 'WARNING') {
          mineEntity.point.color = Cesium.Color.fromCssColorString('#f59e0b');
        } else {
          mineEntity.point.color = Cesium.Color.fromCssColorString('#10b981');
        }
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      initCesiumGlobe();
      checkGevStatus();
    });
  </script>
</body>
</html>
